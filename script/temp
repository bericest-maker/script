UI.number(mainPage, "Confirm timeout (s)", function() return CFG.PurchaseTimeout end, function(value) CFG.PurchaseTimeout = value end, 1, 5)
UI.button(mainPage, "Center window", function() fit(true) end)
local releaseButton = UI.button(mainPage, "Release blocked offer", function()
    if S.running or not S.blocked then return end
    local record, target = S.blocked.record, S.blocked.target
    record.skipped[target.display] = target.fingerprint
    clearTarget(record, target)
    status("Offer explicitly skipped. Press Start to resume.")
    refresh()
end)
table.insert(Updates, function()
    startButton.Text = S.running and "Pause loop" or "Start loop"
    startButton.BackgroundColor3 = S.running and UI.row or UI.accent
    startButton.TextColor3 = S.running and UI.text or UI.background
    releaseButton.Visible = S.blocked ~= nil and not S.running
end)

for _, kind in ipairs(KINDS) do
    local page = Pages[kind]
    UI.toggle(page, "Roll " .. kind:lower(), function() return CFG[kind] end, function(value) CFG[kind] = value end)
    local actions = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
        LayoutOrder = UI.next()}, page)
    UI.make("UIGridLayout", {CellSize = UDim2.new(0.5, -3, 1, 0), CellPadding = UDim2.fromOffset(6, 0),
        SortOrder = Enum.SortOrder.LayoutOrder}, actions)
    UI.button(actions, "Select all", function()
        for _, items in pairs(POOLS[kind]) do for _, name in ipairs(items) do CFG.Selected[kind][name] = true end end
        refresh()
    end)
    UI.button(actions, "Clear", function() CFG.Selected[kind] = {} refresh() end)
    local search = UI.make("TextBox", {Text = "", PlaceholderText = "Search " .. kind:lower(),
        ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = UI.text,
        PlaceholderColor3 = UI.muted, BackgroundColor3 = UI.row, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 31), LayoutOrder = UI.next()}, page)
    UI.corner(search, 5)
    table.insert(Interactive, search)
    connect(search:GetPropertyChangedSignal("Text"), function() refresh() end)
    for _, rarity in ipairs(ORDER) do
        local items = POOLS[kind][rarity]
        if items then
            local group = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = UI.next()}, page)
            UI.layout(group, 4)
            local groupHeader = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1,
                LayoutOrder = UI.next()}, group)
            local expanded = false
            local function countSelected()
                local count = 0
                for _, name in ipairs(items) do if CFG.Selected[kind][name] then count = count + 1 end end
                return count
            end
            local master, masterLabel, masterMark = UI.check(groupHeader, rarity,
                function() return countSelected() == #items end,
                function(enabled)
                    for _, name in ipairs(items) do CFG.Selected[kind][name] = enabled end
                    if enabled then expanded = true end
                end, COLORS[rarity])
            master.Size = UDim2.new(1, -35, 1, 0)
            local caret = UI.button(groupHeader, ">", function() expanded = not expanded refresh() end)
            caret.Size = UDim2.fromOffset(28, 32)
            caret.Position = UDim2.new(1, -28, 0, 0)
            local grid = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = UI.next(), Visible = false}, group)
            UI.make("UIGridLayout", {CellSize = UDim2.new(0.5, -3, 0, 32), CellPadding = UDim2.fromOffset(6, 5),
                SortOrder = Enum.SortOrder.LayoutOrder}, grid)
            local itemButtons = {}
            for _, name in ipairs(items) do
                local button = UI.check(grid, name, function() return CFG.Selected[kind][name] == true end,
                    function(enabled) CFG.Selected[kind][name] = enabled end)
                itemButtons[name] = button
            end
            table.insert(Updates, function()
                local count = countSelected()
                masterLabel.Text = rarity .. "  " .. count .. "/" .. #items
                if count > 0 and count < #items then
                    masterMark.Text = "-"
                    masterMark.BackgroundColor3 = Color3.fromRGB(93, 111, 82)
                end
                local query, matches = normalize(search.Text), 0
                for name, button in pairs(itemButtons) do
                    local match = query == "" or normalize(name):find(query, 1, true) ~= nil
                    button.Visible = match
                    if match then matches = matches + 1 end
                end
                group.Visible = matches > 0
                grid.Visible = expanded or query ~= ""
                caret.Text = grid.Visible and "v" or ">"
            end)
        end
    end
end


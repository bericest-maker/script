local Pages, TabButtons, Fitters = {}, {}, {}
local currentTab = "Main"

local function fitCanvas(page)
    local existing = Fitters[page.Name]
    if existing then existing() return end
    local layout = page:FindFirstChildOfClass("UIListLayout")
    if not layout then return end
    local padding = page:FindFirstChildOfClass("UIPadding")
    local function update()
        if not S.alive or not layout.Parent then return end
        local y = layout.AbsoluteContentSize.Y
        if padding then y = y + padding.PaddingTop.Offset + padding.PaddingBottom.Offset end
        page.CanvasSize = UDim2.fromOffset(0, math.max(y + 4, 1))
    end
    Fitters[page.Name] = update
    update()
    connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), update)
    task.defer(update)
end

for _, name in ipairs({"Main", "Monsters", "Buildings", "Traits"}) do
    local page = UI.make("ScrollingFrame", {Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ScrollBarThickness = 2, ScrollBarImageColor3 = Color3.fromRGB(70, 88, 118), CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.None, ScrollingEnabled = true, Active = true,
        VerticalScrollBarInset = Enum.ScrollBarInset.None, ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = name == "Main"}, content)
    UI.make("UIPadding", {PaddingRight = UDim.new(0, 6), PaddingLeft = UDim.new(0, 1),
        PaddingTop = UDim.new(0, 1), PaddingBottom = UDim.new(0, 6)}, page)
    UI.list(page, 2)
    Pages[name] = page
    local tab = UI.make("TextButton", {Text = name:upper(), Font = Enum.Font.GothamBold, TextSize = 8,
        TextColor3 = UI.dim, BackgroundColor3 = UI.row, AutoButtonColor = false, Active = true}, tabBar)
    UI.corner(tab, 3)
    table.insert(Interactive, tab)
    TabButtons[name] = tab
    connect(tab.Activated, function()
        currentTab = name
        for key, other in pairs(Pages) do other.Visible = key == name end
        page.CanvasPosition = Vector2.new(0, 0)
        refresh()
        task.defer(function() fitCanvas(page) end)
    end)
    fitCanvas(page)
end

local minimized = false
local function applySize()
    main.Size = UDim2.fromOffset(BASE_W, minimized and HEAD_H or BASE_H)
    tabBar.Visible = not minimized
    content.Visible = not minimized
    footer.Visible = not minimized
    miniButton.Text = minimized and "+" or "-"
end

connect(miniButton.Activated, function()
    minimized = not minimized
    S.minimized = minimized
    applySize()
end)

local function viewport()
    local camera = workspace.CurrentCamera
    local size = camera and camera.ViewportSize or Vector2.new(1280, 720)
    if size.X < 1 or size.Y < 1 then size = Vector2.new(1280, 720) end
    return size
end

local function clampCenter(center)
    local view = viewport()
    local half = main.AbsoluteSize * 0.5
    return Vector2.new(
        math.clamp(center.X, half.X + 4, math.max(half.X + 4, view.X - half.X - 4)),
        math.clamp(center.Y, half.Y + 4, math.max(half.Y + 4, view.Y - half.Y - 4)))
end

local fit
fit = function(center)
    if not S.alive then return end
    S.fitVersion = S.fitVersion + 1
    local version = S.fitVersion
    local view = viewport()
    local auto = math.clamp(math.min((view.X - 10) / BASE_W, (view.Y - 10) / BASE_H), 0.45, 1.6)
    scale.Scale = CFG.AutoFit and auto or math.clamp(CFG.GUIScale or 1, 0.45, 1.6)
    applySize()
    if center then
        main.Position = UDim2.fromScale(0.5, 0.5)
    else
        task.defer(function()
            RunService.Heartbeat:Wait()
            if S.alive and S.fitVersion == version then
                local position = clampCenter(main.AbsolutePosition + main.AbsoluteSize * 0.5)
                main.Position = UDim2.fromOffset(position.X, position.Y)
            end
        end)
    end
end


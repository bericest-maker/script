local WEBHOOK = "https://discord.com/api/webhooks/1529331358030106634/BgNcGV0x4t-qDE__u9Z-jAEdfQ7cpGogadEOe7JK4GR5cT80Lp0gaGv1qrTkBtUJM2jh"

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Structures = ReplicatedStorage.Shared.Resources.PlotResources.Structures

local BATCH_SIZE = 50

local function serialize(v)
    if typeof(v) == "Vector3" then
        return string.format("Vector3(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z)

    elseif typeof(v) == "CFrame" then
        local p = v.Position
        return string.format("CFrame(%.3f, %.3f, %.3f)", p.X, p.Y, p.Z)

    elseif typeof(v) == "Color3" then
        return string.format("Color3(%.3f, %.3f, %.3f)", v.R, v.G, v.B)

    elseif typeof(v) == "EnumItem" then
        return tostring(v)

    elseif typeof(v) == "Instance" then
        return v:GetFullName()

    elseif type(v) == "table" then
        local t = {}

        for k, x in pairs(v) do
            t[#t + 1] = tostring(k) .. "=" .. serialize(x)
        end

        return "{" .. table.concat(t, ", ") .. "}"

    elseif type(v) == "string" then
        return '"' .. v:gsub('"', '\\"') .. '"'

    else
        return tostring(v)
    end
end

local function getProperties(obj)
    local lines = {}

    for _, property in ipairs({
        "Size",
        "Position",
        "CFrame",
        "Color",
        "Material",
        "Transparency",
        "Reflectance",
        "Anchored",
        "CanCollide",
        "CanTouch",
        "CanQuery",
        "MeshId",
        "TextureID",
        "TextureId",
        "MeshSize",
        "Shape",
        "CastShadow"
    }) do
        local ok, value = pcall(function()
            return obj[property]
        end)

        if ok and value ~= nil then
            lines[#lines + 1] = property .. "=" .. serialize(value)
        end
    end

    return lines
end

local function dumpBuilding(building)
    local lines = {}

    lines[#lines + 1] = "=================================================="
    lines[#lines + 1] = "BUILDING: " .. building.Name
    lines[#lines + 1] = "=================================================="
    lines[#lines + 1] = ""

    for _, obj in ipairs(building:GetDescendants()) do

        if obj:IsA("BasePart") then
            lines[#lines + 1] = "[PART]"
            lines[#lines + 1] = "Name=" .. obj.Name
            lines[#lines + 1] = "ClassName=" .. obj.ClassName

            for _, property in ipairs(getProperties(obj)) do
                lines[#lines + 1] = property
            end

            lines[#lines + 1] = ""

        elseif obj:IsA("Model") or obj:IsA("Folder") then
            lines[#lines + 1] = "[OBJECT]"
            lines[#lines + 1] = "Name=" .. obj.Name
            lines[#lines + 1] = "ClassName=" .. obj.ClassName
            lines[#lines + 1] = ""
        end
    end

    lines[#lines + 1] = "END BUILDING"
    lines[#lines + 1] = ""

    return table.concat(lines, "\n")
end

local function safeName(name)
    return name:gsub('[\\/:*?"<>|]', "_")
end

local buildings = {}

for _, building in ipairs(Structures:GetChildren()) do
    local config = building:FindFirstChild("Config")

    if config and config:IsA("ModuleScript") then
        local ok, data = pcall(require, config)

        if ok
            and type(data) == "table"
            and data.BuildingCategory ~= "Decoration"
        then
            buildings[#buildings + 1] = {
                name = building.Name,
                content = dumpBuilding(building)
            }
        end
    end
end

print("found " .. #buildings .. " buildings")

local function sendBatch(batch, batchNumber, totalBatches)

    local filename = string.format(
        "Buildings_%02d_of_%02d.txt",
        batchNumber,
        totalBatches
    )

    local content = ""

    content = content
        .. "BUILDING EXPORT\n"
        .. "BATCH " .. batchNumber .. "/" .. totalBatches .. "\n"
        .. "BUILDINGS: " .. #batch .. "\n\n"

    for _, building in ipairs(batch) do
        content = content .. building.content
    end

    if writefile then
        if not isfolder("Buildings") then
            makefolder("Buildings")
        end

        writefile(
            "Buildings/" .. filename,
            content
        )
    end

    local boundary =
        "----DeltaBuildingExport"
        .. tostring(math.random(100000, 999999))

    local body = ""

    body = body
        .. "--" .. boundary .. "\r\n"
        .. 'Content-Disposition: form-data; name="content"'
        .. "\r\n\r\n"
        .. "building export " .. batchNumber .. "/" .. totalBatches
        .. "\r\n"

    body = body
        .. "--" .. boundary .. "\r\n"
        .. 'Content-Disposition: form-data; name="file"; filename="'
        .. filename
        .. '"\r\n'
        .. "Content-Type: text/plain\r\n\r\n"
        .. content
        .. "\r\n"
        .. "--" .. boundary .. "--\r\n"

    local response = request({
        Url = WEBHOOK,
        Method = "POST",
        Headers = {
            ["Content-Type"] =
                "multipart/form-data; boundary=" .. boundary
        },
        Body = body
    })

    print(
        "sent batch "
        .. batchNumber
        .. "/"
        .. totalBatches
        .. " - "
        .. #batch
        .. " buildings"
    )

    return response
end

if WEBHOOK == "PUTHERE" or WEBHOOK == "" then
    warn("put your discord webhook into WEBHOOK")
    return
end

local totalBatches = math.ceil(#buildings / BATCH_SIZE)

for batchNumber = 1, totalBatches do

    local batch = {}

    local first = ((batchNumber - 1) * BATCH_SIZE) + 1
    local last = math.min(
        batchNumber * BATCH_SIZE,
        #buildings
    )

    for i = first, last do
        batch[#batch + 1] = buildings[i]
    end

    sendBatch(
        batch,
        batchNumber,
        totalBatches
    )

    task.wait(2)
end

print(
    "DONE - "
    .. #buildings
    .. " buildings in "
    .. totalBatches
    .. " files"
)

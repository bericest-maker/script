local minimized = false
local windowWidth, windowHeight = 520, 560
local fit
local function viewport()
    local camera = workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

local function clampCenter(center)
    local view = viewport()
    local half = main.AbsoluteSize * 0.5
    return Vector2.new(math.clamp(center.X, half.X + 8, math.max(half.X + 8, view.X - half.X - 8)),
        math.clamp(center.Y, half.Y + 8, math.max(half.Y + 8, view.Y - half.Y - 8)))
end

fit = function(center)
    S.fitVersion = (S.fitVersion or 0) + 1
    local version = S.fitVersion
    if S.sizeTween then S.sizeTween:Cancel() S.sizeTween = nil end
    local view = viewport()
    windowWidth = CFG.AutoFit and math.clamp(view.X - 28, 320, 520) or 520
    windowHeight = CFG.AutoFit and math.clamp(view.Y - 28, 320, 560) or 560
    scale.Scale = CFG.AutoFit and math.min(1, math.max(0.1, (view.X - 24) / windowWidth),
        math.max(0.1, (view.Y - 24) / windowHeight)) or 1
    main.Size = UDim2.fromOffset(windowWidth, minimized and 49 or windowHeight)
    if center then
        main.Position = UDim2.fromScale(0.5, 0.5)
    else
        task.defer(function()
            RunService.Heartbeat:Wait()
            if S.alive and S.fitVersion == version then
                local position = clampCenter(main.AbsolutePosition + main.AbsoluteSize * 0.5)
                main.Position = UDim2.fromOffset(position.X, position.Y)
            end
        end)
    end
end

local mainPage = Pages.Main
local startButton = UI.button(mainPage, "Start loop", function() setRunning(not S.running) end)
startButton.Size = UDim2.new(1, 0, 0, 38)

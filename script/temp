local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local VU = game:GetService("VirtualUser")
local TS = game:GetService("TweenService")
local LP = Players.LocalPlayer
local CAM = workspace.CurrentCamera

local POOLS = {
Buildings = {
Common = {"CorridorCorner","SlowTrap","SpikeTrap","StoneWall","Torch","WoodFloor","WoodWall","YellowCorridor"},
Uncommon = {"ArrowTrap","BearTrap","CorridorEnd","CorridorT","Crossroads","CurvedWall","SpikedBarricade","TrapRoom","TreasureRoom","WoodDoor"},
Rare = {"Armory","ArrowTower","DragonNest","FireTrap","IronGate","LifeSpring","MonsterDen","OilTrap","PotionShop"},
Epic = {"FrostObelisk","Graveyard","PoisonTrap","SawTrap","WarShrine"},
Legendary = {"FallingRocks","FlameSpire","LavaChamber","RuneObelisk"},
Mythic = {"BossRoom","DragonAltar"},
Secret = {"CrystalHall"},
},
Monsters = {
Common = {"BoneGhoul","GoblinScout","SewerRat","Skeleton","Slime"},
Uncommon = {"Archer","CinderKobold","DireWolf","DuskBat","Goblin","GraveSentinel","ImpTrickster"},
Rare = {"BannerGoblin","BoneGuard","EmberDrake","FrostRevenant","Healer","Knight","Mage","MagmaElemental","SporeShaman","WidowSpider"},
Epic = {"AmethystGolem","Bard","EliteKnight","FrostDrake","Golem","HexArcher","Necromancer","ObsidianGargoyle","SwampTroll","VampireLord"},
Legendary = {"GraveWarden","InfernalWarlord","Ironhorn","RoyalKnight","RuneSage","SkeletonKing","StormDrake"},
Mythic = {"DreadKnight","FrostwingDrake","GildedMimic","Lich","SpiritTotem","VenomHydra"},
Secret = {"AbyssalDragon","BansheeQueen","BoneColossus","Cerberus","FurnaceBrute","Mimic","VoidReaper"},
Divine = {"SeraphOfRuin","SunDragon"},
},
}

local RARITY_ORDER = {"Common","Uncommon","Rare","Epic","Legendary","Mythic","Secret","Divine"}
local RARITY_COLOR = {
Common = Color3.fromRGB(170,175,185),
Uncommon = Color3.fromRGB(110,210,120),
Rare = Color3.fromRGB(90,160,255),
Epic = Color3.fromRGB(180,110,255),
Legendary = Color3.fromRGB(255,185,60),
Mythic = Color3.fromRGB(255,95,95),
Secret = Color3.fromRGB(0,230,220),
Divine = Color3.fromRGB(255,245,170),
}

local MUTATIONS = {
{name = "Golden", chance = 0.014244076185714286},
{name = "Cursed", chance = 0.00025},
{name = "Frozen", chance = 0.001998167},
{name = "Infernal", chance = 0.0006665},
}

local CFG = {
Plot = 2,
Buildings = false,
Monsters = false,
RollDelay = 1.5,
BuyWait = 0.06,
TPHeight = 3,
MutationOnly = false,
AnyMutation = false,
Want = {Buildings = {}, Monsters = {}},
Mut = {},
}

local function clean(s)
if not s then return "" end
s = tostring(s)
s = s:gsub("%b<>", "")
s = s:gsub("[^%w]", "")
return s:lower()
end

local LOOKUP = {Buildings = {}, Monsters = {}}
for kind, pool in pairs(POOLS) do
CFG.Want[kind] = {}
for rar, items in pairs(pool) do
CFG.Want[kind][rar] = {}
for _, it in ipairs(items) do
CFG.Want[kind][rar][it] = false
LOOKUP[kind][clean(it)] = {rarity = rar, name = it}
end
end
end
for _, m in ipairs(MUTATIONS) do CFG.Mut[m.name] = false end

local function char() return LP.Character or LP.CharacterAdded:Wait() end
local function hrp()
local c = char()
return c:FindFirstChild("HumanoidRootPart") or c:WaitForChild("HumanoidRootPart", 5)
end

local function getRoller(kind)
local map = workspace:FindFirstChild("Map")
local rollers = map and map:FindFirstChild("Rollers")
if not rollers then return nil end
return rollers:FindFirstChild("Plot" .. tostring(CFG.Plot) .. "_" .. kind)
end

local function pivotOf(inst)
if not inst then return nil end
if inst:IsA("BasePart") then return inst.Position end
if inst:IsA("Model") then
local ok, cf = pcall(function() return inst:GetPivot() end)
if ok then return cf.Position end
end
local p = inst.Parent
while p and p ~= workspace do
if p:IsA("BasePart") then return p.Position end
if p:IsA("Model") then
local ok, cf = pcall(function() return p:GetPivot() end)
if ok then return cf.Position end
end
p = p.Parent
end
local bp = inst:FindFirstChildWhichIsA("BasePart", true)
return bp and bp.Position or nil
end

local function tpTo(pos)
if not pos then return false end
local root = hrp()
if not root then return false end
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
root.CFrame = CFrame.new(pos + Vector3.new(0, CFG.TPHeight, 0))
return true
end

local function txtOf(o)
if not o then return nil end
local ok, v = pcall(function() return o.Text end)
if ok and type(v) == "string" then return v end
local ok2, v2 = pcall(function() return o.Value end)
if ok2 and type(v2) == "string" then return v2 end
return nil
end

local function findDeep(parent, name)
if not parent then return nil end
local d = parent:FindFirstChild(name)
if d then return d end
return parent:FindFirstChild(name, true)
end

local LOG
local function log(t) if LOG then LOG.Text = tostring(t) end end

local function readDisplay(kind, display)
local rawItem = txtOf(findDeep(display, "ItemName")) or ""
local rawRar = txtOf(findDeep(display, "Rarity")) or ""
local mutLabel = txtOf(findDeep(display, "Mutation"))
local hay = ((mutLabel or "") .. " " .. rawItem .. " " .. rawRar):lower()
local mut = nil
for _, m in ipairs(MUTATIONS) do
if hay:find(m.name:lower(), 1, true) then mut = m.name break end
end
local cItem = clean(rawItem)
local found = LOOKUP[kind][cItem]
if not found then
local best = 0
for key, info in pairs(LOOKUP[kind]) do
if #key > best and cItem:find(key, 1, true) then
found = info
best = #key
end
end
end
return found, mut, rawItem
end

local function wanted(kind, info, mut)
if not info then return false end
local t = CFG.Want[kind] and CFG.Want[kind][info.rarity]
if not (t and t[info.name]) then return false end
if kind == "Monsters" and CFG.MutationOnly then
if CFG.AnyMutation then return mut ~= nil end
if not mut then return false end
return CFG.Mut[mut] == true
end
return true
end

local function firePrompt(prompt)
pcall(function()
if fireproximityprompt then
fireproximityprompt(prompt)
else
prompt:InputHoldBegin()
task.wait((prompt.HoldDuration or 0) + 0.05)
prompt:InputHoldEnd()
end
end)
end

local function buyDisplay(display, name)
local prompt = findDeep(display, "BuyPrompt")
if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
tpTo(pivotOf(prompt))
task.wait(CFG.BuyWait)
local before = txtOf(findDeep(display, "ItemName")) or ""
firePrompt(prompt)
task.wait(CFG.BuyWait + 0.04)
if (txtOf(findDeep(display, "ItemName")) or "") == before then
firePrompt(prompt)
task.wait(0.12)
end
log("B " .. name)
return true
end

local function getDisplays(roller)
local out = {}
for _, c in ipairs(roller:GetChildren()) do
if c.Name:match("^Display") then table.insert(out, c) end
end
table.sort(out, function(a, b) return a.Name < b.Name end)
return out
end

local function scan(kind, roller)
if not roller then return false end
local bought = false
for _, display in ipairs(getDisplays(roller)) do
local info, mut = readDisplay(kind, display)
if info and wanted(kind, info, mut) then
buyDisplay(display, (mut and (mut .. " ") or "") .. info.name)
bought = true
end
end
return bought
end

local function fireRoll(kind)
local roller = getRoller(kind)
if not roller then
log("no roller Plot" .. CFG.Plot .. "_" .. kind)
return
end
local btn = roller:FindFirstChild("RollButton") or findDeep(roller, "RollButton")
local cd = nil
if btn then
cd = btn:FindFirstChild("RollClick") or btn:FindFirstChildWhichIsA("ClickDetector", true)
end
if not cd then cd = roller:FindFirstChildWhichIsA("ClickDetector", true) end
if not cd then
log("no RollClick " .. kind)
return
end
tpTo(pivotOf(btn or cd))
task.wait(0.05)
pcall(function()
if fireclickdetector then
fireclickdetector(cd)
task.wait(0.03)
fireclickdetector(cd, 0)
end
end)
end

task.spawn(function()
while true do
task.wait(20)
pcall(function()
VU:CaptureController()
VU:ClickButton2(Vector2.new(0, 0))
end)
end
end)
pcall(function()
LP.Idled:Connect(function()
pcall(function()
VU:CaptureController()
VU:ClickButton2(Vector2.new(0, 0))
end)
end)
end)

local running = false
task.spawn(function()
while true do
task.wait(0.05)
if running then
local kinds = {}
if CFG.Monsters then table.insert(kinds, "Monsters") end
if CFG.Buildings then table.insert(kinds, "Buildings") end
if #kinds == 0 then
task.wait(0.4)
else
local boughtAny = false
for _, k in ipairs(kinds) do
if not running then break end
local roller = getRoller(k)
if scan(k, roller) then boughtAny = true end
end
if boughtAny then
task.wait(0.15)
for _, k in ipairs(kinds) do scan(k, getRoller(k)) end
else
for _, k in ipairs(kinds) do
if not running then break end
fireRoll(k)
end
task.wait(CFG.RollDelay)
for _, k in ipairs(kinds) do
if not running then break end
scan(k, getRoller(k))
end
end
end
end
end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "RL_" .. tostring(math.random(100000, 999999))
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = true
pcall(function() gui.Parent = game:GetService("CoreGui") end)
if not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end

local function corner(p, r)
local c = Instance.new("UICorner")
c.CornerRadius = UDim.new(0, r or 6)
c.Parent = p
return c
end
local function stroke(p, col, t)
local s = Instance.new("UIStroke")
s.Color = col or Color3.fromRGB(45, 48, 62)
s.Thickness = t or 1
s.Parent = p
return s
end

local main = Instance.new("Frame")
main.BackgroundColor3 = Color3.fromRGB(16, 17, 24)
main.BorderSizePixel = 0
main.Active = true
main.ClipsDescendants = true
main.Parent = gui
corner(main, 8)
stroke(main, Color3.fromRGB(55, 58, 80))

local function fit()
local vs = CAM.ViewportSize
local w = math.clamp(math.floor(vs.X * 0.32), 300, 430)
local h = math.clamp(math.floor(vs.Y * 0.84), 400, 760)
main.Size = UDim2.fromOffset(w, h)
main.Position = UDim2.new(0.5, -math.floor(w / 2), 0.5, -math.floor(h / 2))
end
fit()
pcall(function()
CAM:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end)


local Traits = game:GetService("ReplicatedStorage")
    .Shared.Resources.TraitResources.Traits

local output = {}

for _, trait in ipairs(Traits:GetChildren()) do
    local config = trait:FindFirstChild("Config")

    if config and config:IsA("ModuleScript") then
        local ok, data = pcall(require, config)

        if ok and type(data) == "table" then
            local lines = {}

            table.insert(lines, "trait: " .. trait.Name)
            table.insert(lines, "rarity: " .. tostring(data.Rarity or "none"))
            table.insert(lines, "description: " .. tostring(data.Description or "none"))

            if data.ResourceProduction then
                local rp = data.ResourceProduction

                for name, value in pairs(rp.Multipliers or {}) do
                    if not string.find(string.lower(name), "essence") then
                        table.insert(lines, name .. ": " .. tostring(value))
                    end
                end

                for name, value in pairs(rp.Modifiers or {}) do
                    if not string.find(string.lower(name), "essence") then
                        table.insert(lines, name .. ": " .. tostring(value))
                    end
                end
            end

            if data.Unit then
                for name, value in pairs(data.Unit.Multipliers or {}) do
                    table.insert(lines, "unit " .. name .. ": " .. tostring(value))
                end

                for name, value in pairs(data.Unit.Modifiers or {}) do
                    table.insert(lines, "unit " .. name .. ": " .. tostring(value))
                end
            end

            if data.Appearance and data.Appearance.Size then
                table.insert(lines, "size: " .. tostring(data.Appearance.Size))
            end

            if data.Bounty and data.Bounty.Money then
                table.insert(lines, "bounty money: " .. tostring(data.Bounty.Money))
            end

            table.insert(output, table.concat(lines, "\n"))
        end
    end
end

setclipboard(table.concat(output, "\n\n--------------------\n\n"))
print("copied " .. #output .. " traits to clipboard")

    ["Plot"] = 2,
    ["Monsters"] = true,
    ["Buildings"] = true,
    ["FastBuy"] = true,
    ["AntiIdle"] = true,
    ["AutoFit"] = true,
    ["RollDelay"] = 1.5,
    ["TravelDelay"] = 0.05,
    ["PurchaseTimeout"] = 2,
    ["MutationOnly"] = false,
    ["AnyMutation"] = false,
    ["Mut"] = {
        ["Golden"] = false,
        ["Cursed"] = false,
        ["Frozen"] = false,
        ["Infernal"] = false,
    },
    ["Selected"] = {
        ["Monsters"] = {},
        ["Buildings"] = {},
    },
}

local POOLS = {

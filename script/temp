local BASE_W, BASE_H, HEAD_H = 276, 320, 24
local Env = type(getgenv) == "function" and getgenv() or _G
local previous = Env.AutoRollV4
if type(previous) == "table" and type(previous.Stop) == "function" then pcall(previous.Stop) end

local S = {alive = true, running = false, busy = false, session = 0, cursor = 0, minimized = false,
    message = "idle | select targets, then start", blocked = nil, lastIdle = os.clock(), fitVersion = 0}
local Runtime = {Config = CFG}
Env.AutoRollV4 = Runtime
local Connections, Updates, Interactive = {}, {}, {}
local Records, Labels = {}, setmetatable({}, {__mode = "k"})
local Lookup = {Monsters = {}, Buildings = {}}
local refresh = function() end
local drawStatus = function() end
local gui, main, scale, header, tabBar, content, footer, statusLabel

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Connections, connection)
    return connection
end

local function normalize(value)
    return (tostring(value or ""):gsub("<[^>]*>", ""):gsub("[^%w]", "")):lower()
end

for kind, pool in pairs(POOLS) do
    for rarity, items in pairs(pool) do
        for _, name in ipairs(items) do
            Lookup[kind][normalize(name)] = {name = name, rarity = rarity}
        end
    end
end

local function status(message)
    if S.message ~= message then S.message = message drawStatus() end
end

local function pause(message)
    S.running = false
    S.session = S.session + 1
    status(message)
    refresh()
end

local function active(session)
    return S.alive and S.running and S.session == session
end

local function waitActive(seconds, session)
    local deadline = os.clock() + seconds
    repeat
        RunService.Heartbeat:Wait()
        if not active(session) then return false end
    until os.clock() >= deadline
    return true
end

local function rootPart()
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if humanoid and humanoid.Health > 0 and root then return root end
    return nil
end

local function field(display, name)
    local cached = Labels[display]
    if not cached then cached = {} Labels[display] = cached end
    local node = cached[name]
    if node and node.Parent and node:IsDescendantOf(display) then return node end
    local label = display:FindFirstChild("OfferLabel", true)
    node = (label and label:FindFirstChild(name, true)) or display:FindFirstChild(name, true)
    cached[name] = node
    return node
end

local function text(node)
    if not node then return "", false end
    if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then return node.Text, true end
    if node:IsA("StringValue") then return node.Value, true end
    local nested = node:FindFirstChildWhichIsA("TextLabel", true)
    if nested then return nested.Text, true end
    return "", false
end

local function getPrompt(display)
    local named = display:FindFirstChild("BuyPrompt", true)
    if not named then return nil end
    if named:IsA("ProximityPrompt") then return named end
    return named:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function readOffer(kind, display)
    local itemNode = field(display, "ItemName")
    local raw, readable = text(itemNode)
    local key = normalize(raw)
    local info = Lookup[kind][key]
    local mutation, mutationText = nil, ""
    if kind == "Monsters" then
        mutationText = text(field(display, "Mutation"))
        if mutationText == "" then mutationText = tostring(display:GetAttribute("Mutation") or "") end
        local plain = mutationText:gsub("<[^>]*>", ""):lower()
        local mutationKey = normalize(mutationText)
        for _, m in ipairs(MUTATIONS) do
            local mk = normalize(m.name)
            if mutationKey == mk or plain:find("%f[%a]" .. mk .. "%f[%A]") then mutation = m.name end
            if not info then
                local stripped
                if key:sub(1, #mk) == mk then stripped = key:sub(#mk + 1)
                elseif key:sub(-#mk) == mk then stripped = key:sub(1, #key - #mk) end
                if stripped and Lookup[kind][stripped] then
                    info = Lookup[kind][stripped]
                    mutation = mutation or m.name
                end
            end
        end
    end
    local empty = key == "" or key == "sold" or key == "soldout" or key == "purchased" or key == "empty"
    return {display = display, valid = readable, raw = raw, info = info, mutation = mutation,
        empty = empty, prompt = getPrompt(display), fingerprint = key .. "|" .. normalize(mutationText)}
end

local function wanted(kind, offer)
    if not offer.info or CFG.Selected[kind][offer.info.name] ~= true then return false end
    if kind == "Buildings" or not CFG.MutationOnly then return true end
    if not offer.mutation then return false end
    return CFG.AnyMutation or CFG.Mut[offer.mutation] == true
end

local function hasSelection(kind)
    for name, enabled in pairs(CFG.Selected[kind]) do
        if enabled and Lookup[kind][normalize(name)] then return true end
    end
    return false
end

local function hasPending()
    for _, record in pairs(Records) do
        if #record.pending > 0 then return true end
    end
    return false
end

local function positionOf(instance)
    local node = instance
    while node and node ~= workspace do
        if node:IsA("Attachment") then return node.WorldPosition end
        if node:IsA("BasePart") then return node.Position end
        if node:IsA("Model") then
            if node.PrimaryPart or node:FindFirstChildWhichIsA("BasePart", true) then
                return node:GetPivot().Position
            end
        end
        node = node.Parent
    end
    return nil
end

local function moveNear(instance, distance, session)
    local root = rootPart()
    local position = positionOf(instance)
    if not root or not position or distance <= 0 then return false end
    local offset = Vector3.new(0, math.min(1.7, distance * 0.25), math.min(2, distance * 0.4))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(position + offset, position)
    if not waitActive(CFG.TravelDelay, session) then return false end
    return rootPart() == root and (root.Position - position).Magnitude <= distance
end

local function getRecord(kind)
    local map = workspace:FindFirstChild("Map")
    local rollers = map and map:FindFirstChild("Rollers")
    local name = "Plot" .. tostring(CFG.Plot) .. "_" .. kind
    local roller = rollers and rollers:FindFirstChild(name)
    if not roller then pause("missing " .. name .. " | check plot") return nil end
    local record = Records[kind]
    if record and record.roller ~= roller and (#record.pending > 0 or record.phase == "waiting") then
        pause("roller swapped with offer pending | recheck plot")
        return nil
    end
    if not record or record.roller ~= roller then
        record = {kind = kind, roller = roller, phase = "checking", pending = {}, skipped = {}, consumed = {},
            displays = {}, due = os.clock(), stableAt = 0, signature = nil}
        Records[kind] = record
    end
    if not record.detector or not record.detector:IsDescendantOf(roller) then
        local button = roller:FindFirstChild("RollButton", true)
        local detector = button and button:FindFirstChild("RollClick", true)
        if not detector or not detector:IsA("ClickDetector") then
            pause("missing RollButton.RollClick on " .. name)
            return nil
        end
        record.detector = detector
    end
    for i = 1, 3 do
        local display = record.displays[i]
        if not display or not display:IsDescendantOf(roller) then
            display = roller:FindFirstChild("Display" .. i, true)
            record.displays[i] = display
        end
        if not display then pause("missing " .. name .. ".Display" .. i) return nil end
    end
    return record
end

local function inspect(record)
    if #record.pending > 0 then return end
    local now = os.clock()
    if record.phase == "waiting" and now < record.due then return end
    local offers, pieces, unknown = {}, {}, nil
    for i, display in ipairs(record.displays) do
        if not display:IsDescendantOf(record.roller) then
            pause("display unloaded | offer protected, no reroll") return
        end
        local offer = readOffer(record.kind, display)
        offers[i] = offer
        pieces[i] = offer.fingerprint .. (offer.prompt and tostring(offer.prompt.Enabled) or "missing")
        if not offer.valid or (not offer.empty and not offer.info) then
            unknown = display.Name .. ": " .. (offer.raw ~= "" and offer.raw or "unreadable ItemName")
        end
    end
    local signature = table.concat(pieces, "\n")
    if signature ~= record.signature then
        record.signature = signature
        record.stableAt = now
        record.phase = "checking"
        return
    end
    if now - record.stableAt < (CFG.FastBuy and 0.03 or 0.12) then return end
    if unknown then
        if now - record.due > math.max(2, CFG.PurchaseTimeout) then
            pause(record.kind .. " " .. unknown .. " | no reroll sent")
        end
        return
    end
    record.phase = "ready"
    for _, offer in ipairs(offers) do
        if wanted(record.kind, offer) and record.skipped[offer.display] ~= offer.fingerprint
            and record.consumed[offer.display] ~= offer.fingerprint then
            table.insert(record.pending, offer)
        end
    end
end

local function clearTarget(record, target)
    if record.pending[1] == target then table.remove(record.pending, 1) end
    record.phase = "checking"
    record.signature = nil
    record.due = os.clock()
    if S.blocked and S.blocked.target == target then S.blocked = nil end
end

local function block(record, target, message)
    S.blocked = {record = record, target = target}
    pause(message)
end

local function purchase(record, target, session)
    if not active(session) then return end
    if not CFG[record.kind] or not wanted(record.kind, target) then
        block(record, target, "offer protected | re-enable it or release") return
    end
    local before = readOffer(record.kind, target.display)
    if not before.valid then block(record, target, "cannot read offer | no reroll sent") return end
    if before.fingerprint ~= target.fingerprint then clearTarget(record, target) return end
    local prompt = before.prompt
    if not prompt then block(record, target, "missing BuyPrompt for " .. target.info.name) return end
    local root = rootPart()
    local origin = root and root.CFrame
    if not moveNear(prompt, prompt.MaxActivationDistance, session) then
        if active(session) then block(record, target, "cannot reach " .. target.info.name .. " | no reroll") end
        return
    end
    local deadline = os.clock() + CFG.PurchaseTimeout
    while active(session) and prompt.Parent and not prompt.Enabled and os.clock() < deadline do
        RunService.Heartbeat:Wait()
    end
    if not active(session) then return end
    local current = readOffer(record.kind, target.display)
    if not current.valid then block(record, target, "labels changed | lock kept, press start") return end
    if current.fingerprint ~= target.fingerprint then clearTarget(record, target) return end
    if not CFG[record.kind] or not wanted(record.kind, current) then
        block(record, target, "selection changed | re-enable or release") return
    end
    if not prompt.Parent or not prompt.Enabled or current.prompt ~= prompt then
        block(record, target, "BuyPrompt not ready for " .. target.info.name) return
    end
    status("buying " .. (target.mutation and target.mutation .. " " or "") .. target.info.name)
    local sent, problem
    if CFG.FastBuy and type(fireproximityprompt) == "function" then
        sent, problem = pcall(fireproximityprompt, prompt)
    else
        S.activePrompt = prompt
        sent, problem = pcall(function()
            prompt:InputHoldBegin()
            waitActive(prompt.HoldDuration, session)
            prompt:InputHoldEnd()
        end)
        if not sent then pcall(function() prompt:InputHoldEnd() end) end
        S.activePrompt = nil
    end
    if not active(session) then return end
    if not sent then block(record, target, "prompt failed | " .. tostring(problem)) return end
    deadline = os.clock() + CFG.PurchaseTimeout
    local clearedAt
    while active(session) and os.clock() < deadline do
        if not target.display:IsDescendantOf(record.roller) or not record.roller:IsDescendantOf(workspace) then
            block(record, target, "display unloaded before confirm | lock kept") return
        end
        local after = readOffer(record.kind, target.display)
        local consumed = after.valid and (after.empty or after.fingerprint ~= target.fingerprint)
        local removed = after.valid and not prompt.Parent and not after.prompt
        if consumed or removed then
            clearedAt = clearedAt or os.clock()
            if os.clock() - clearedAt >= 0.03 then
                record.consumed[target.display] = target.fingerprint
                clearTarget(record, target)
                if rootPart() == root and origin and active(session) then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.CFrame = origin
                end
                status("bought " .. target.info.name .. " | reroll cleared")
                refresh()
                return
            end
        else
            clearedAt = nil
        end
        RunService.Heartbeat:Wait()
    end
    if active(session) then
        block(record, target, "unconfirmed " .. target.info.name .. " | start retries, release skips")
    end
end

local function roll(record, session)
    if not active(session) or S.busy or hasPending() or not CFG[record.kind] then return end
    local detector = record.detector
    if not moveNear(detector, detector.MaxActivationDistance, session) then
        if active(session) then pause("cannot reach " .. record.kind .. " RollButton") end
        return
    end
    for _, other in pairs(Records) do
        if CFG[other.kind] then inspect(other) end
    end
    if not active(session) or hasPending() or record.phase ~= "ready" then return end
    if not CFG[record.kind] or not hasSelection(record.kind) then return end
    for _, other in pairs(Records) do
        if CFG[other.kind] and hasSelection(other.kind) and other.phase == "checking" then return end
    end
    if type(fireclickdetector) ~= "function" then pause("executor lacks fireclickdetector") return end
    local ok, problem = pcall(fireclickdetector, detector, 0)
    if not ok then pause("roll failed | " .. tostring(problem)) return end
    record.phase = "waiting"
    record.due = os.clock() + math.max(1.5, CFG.RollDelay)
    record.signature = nil
    record.skipped = {}
    record.consumed = {}
    status("rolling " .. record.kind .. " | plot " .. CFG.Plot)
end

local function tick()
    if not rootPart() then status("waiting for character...") return end
    local ready = {}
    for _, kind in ipairs(KINDS) do
        if CFG[kind] and hasSelection(kind) then
            local record = getRecord(kind)
            if not record or not S.running then return end
            table.insert(ready, record)
            inspect(record)
            if not S.running then return end
        end
    end
    local session = S.session
    for _, kind in ipairs(KINDS) do
        local record = Records[kind]
        if record and #record.pending > 0 then
            S.busy = true
            purchase(record, record.pending[1], session)
            S.busy = false
            return
        end
    end
    if #ready == 0 then status("choose targets in monsters or buildings") return end
    for i = 1, #ready do
        local index = (S.cursor + i - 1) % #ready + 1
        local record = ready[index]
        if record.phase == "ready" then
            roll(record, session)
            S.cursor = index
            return
        end
    end
end

local function setRunning(enabled)
    if not enabled then pause("paused | pending offers kept") return end
    if type(fireclickdetector) ~= "function" then pause("executor lacks fireclickdetector") return end
    if not (CFG.Monsters and hasSelection("Monsters")) and not (CFG.Buildings and hasSelection("Buildings")) and not hasPending() then
        pause("select at least one target first") return
    end
    if CFG.Monsters and CFG.MutationOnly and not CFG.AnyMutation then
        local any = false
        for _, on in pairs(CFG.Mut) do if on then any = true end end
        if not any then pause("pick a mutation in traits, or disable filter") return end
    end
    S.session = S.session + 1
    S.running = true
    status("running | plot " .. CFG.Plot)
    refresh()
end

local function idlePulse()
    if not S.alive or not CFG.AntiIdle or S.busy then return end
    S.lastIdle = os.clock()
    local ok = pcall(function()
        local camera = workspace.CurrentCamera
        local virtualUser = game:GetService("VirtualUser")
        virtualUser:CaptureController()
        virtualUser:ClickButton2(Vector2.zero, camera and camera.CFrame or CFrame.new())
    end)
    if not ok then
        ok = pcall(function()
            local virtualInput = game:GetService("VirtualInputManager")
            virtualInput:SendKeyEvent(true, Enum.KeyCode.F15, false, game)
            virtualInput:SendKeyEvent(false, Enum.KeyCode.F15, false, game)
        end)
    end
    if not ok and not S.idleWarned then
        S.idleWarned = true
        status("anti-idle input unavailable in this executor")
    end
end

function Runtime.Stop()
    if not S.alive then return end
    S.alive = false
    S.running = false
    S.session = S.session + 1
    if S.activePrompt then pcall(function() S.activePrompt:InputHoldEnd() end) end
    for _, connection in ipairs(Connections) do pcall(function() connection:Disconnect() end) end
    if gui then gui:Destroy() end
    if Env.AutoRollV4 == Runtime then Env.AutoRollV4 = nil end
end

local UI = {}
UI.amber = Color3.fromRGB(255, 179, 64)
UI.mint = Color3.fromRGB(99, 230, 176)
UI.bg = Color3.fromRGB(17, 24, 37)
UI.bar = Color3.fromRGB(24, 33, 50)
UI.row = Color3.fromRGB(24, 33, 49)
UI.line = Color3.fromRGB(43, 54, 72)
UI.text = Color3.fromRGB(232, 237, 245)
UI.muted = Color3.fromRGB(147, 160, 180)
UI.dim = Color3.fromRGB(109, 122, 143)
UI.order = 0
UI.ROW, UI.SEC, UI.NUM, UI.CELL, UI.RAR = 17, 13, 18, 16, 18

function UI.make(class, properties, parent)
    local object = Instance.new(class)
    for key, value in pairs(properties or {}) do object[key] = value end
    if object:IsA("GuiObject") then object.BorderSizePixel = 0 end
    object.Parent = parent
    return object
end

function UI.next()
    UI.order = UI.order + 1
    return UI.order
end

function UI.corner(parent, radius)
    UI.make("UICorner", {CornerRadius = UDim.new(0, radius or 3)}, parent)
end

function UI.list(parent, gap)
    return UI.make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or 2)}, parent)
end

function UI.text(parent, value, size, color, height)
    local label = UI.make("TextLabel", {Text = value, Font = Enum.Font.Gotham, TextSize = size or 10,
        TextColor3 = color or UI.text, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, 0, 0, height or 14),
        LayoutOrder = UI.next()}, parent)
    return label
end

function UI.button(parent, height, callback, baseColor)
    local base = baseColor or UI.row
    local button = UI.make("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = base,
        Size = UDim2.new(1, 0, 0, height or UI.ROW), LayoutOrder = UI.next(), Active = true}, parent)
    UI.corner(button, 3)
    table.insert(Interactive, button)
    connect(button.Activated, callback)
    connect(button.MouseEnter, function() button.BackgroundColor3 = Color3.fromRGB(33, 45, 65) end)
    connect(button.MouseLeave, function() button.BackgroundColor3 = base end)
    return button
end

function UI.section(parent, value)
    local label = UI.text(parent, value, 8, UI.dim, UI.SEC)
    label.Font = Enum.Font.GothamBold
    label.Text = value:upper()
    local pad = UI.make("UIPadding", {PaddingTop = UDim.new(0, 5)}, label)
    return label, pad
end

function UI.toggle(parent, value, getter, setter)
    local button = UI.button(parent, UI.ROW, function() setter(not getter()) refresh() end)
    local label = UI.text(button, value, 10, UI.text, UI.ROW - 4)
    label.Position = UDim2.fromOffset(6, 2)
    label.Size = UDim2.new(1, -40, 0, UI.ROW - 4)
    label.LayoutOrder = 0
    local track = UI.make("Frame", {Size = UDim2.fromOffset(22, 11), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0), BackgroundColor3 = Color3.fromRGB(44, 55, 77)}, button)
    UI.corner(track, 6)
    local knob = UI.make("Frame", {Size = UDim2.fromOffset(9, 9), Position = UDim2.fromOffset(1, 1),
        BackgroundColor3 = Color3.fromRGB(125, 138, 160)}, track)
    UI.corner(knob, 5)
    table.insert(Updates, function()
        local on = getter()
        track.BackgroundColor3 = on and UI.amber or Color3.fromRGB(44, 55, 77)
        knob.BackgroundColor3 = on and Color3.fromRGB(42, 28, 5) or Color3.fromRGB(125, 138, 160)
        knob.Position = UDim2.fromOffset(on and 12 or 1, 1)
        label.TextColor3 = on and UI.text or UI.muted
    end)
    return button
end

function UI.check(parent, value, getter, setter, color, height)
    local button = UI.button(parent, height or UI.CELL, function() setter(not getter()) refresh() end,
        Color3.fromRGB(20, 27, 40))
    local box = UI.make("Frame", {Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(4, ((height or UI.CELL) - 10) / 2),
        BackgroundColor3 = Color3.fromRGB(17, 24, 37)}, button)
    UI.make("UIStroke", {Color = Color3.fromRGB(60, 74, 99), Thickness = 1}, box)
    UI.corner(box, 2)
    local mark = UI.make("TextLabel", {Text = "x", Font = Enum.Font.GothamBold, TextSize = 8,
        TextColor3 = Color3.fromRGB(35, 23, 3), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
        TextTransparency = 1}, box)
    local label = UI.text(button, value, 9, color or UI.muted, (height or UI.CELL) - 4)
    label.Position = UDim2.fromOffset(18, 2)
    label.Size = UDim2.new(1, -22, 0, (height or UI.CELL) - 4)
    label.LayoutOrder = 0
    table.insert(Updates, function()
        local on = getter()
        box.BackgroundColor3 = on and UI.amber or Color3.fromRGB(17, 24, 37)
        mark.TextTransparency = on and 0 or 1
        label.TextColor3 = on and (color or UI.text) or UI.dim
    end)
    return button, label, box, mark
end

function UI.number(parent, title, getter, setter, minimum, maximum, integer)
    local row = UI.make("Frame", {Size = UDim2.new(1, 0, 0, UI.NUM), BackgroundColor3 = UI.row,
        LayoutOrder = UI.next()}, parent)
    UI.corner(row, 3)
    local label = UI.text(row, title, 9, UI.muted, UI.NUM - 6)
    label.Position = UDim2.fromOffset(6, 3)
    label.Size = UDim2.new(1, -64, 0, UI.NUM - 6)
    label.LayoutOrder = 0
    local input = UI.make("TextBox", {Size = UDim2.fromOffset(48, 13), AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -4, 0, 2.5), Text = tostring(getter()), Font = Enum.Font.Code, TextSize = 9,
        TextColor3 = UI.amber, BackgroundColor3 = Color3.fromRGB(17, 24, 37), ClearTextOnFocus = false,
        TextTruncate = Enum.TextTruncate.AtEnd}, row)
    UI.make("UIStroke", {Color = UI.line, Thickness = 1}, input)
    UI.corner(input, 3)
    table.insert(Interactive, input)
    connect(input.FocusLost, function()
        local value = tonumber(input.Text)
        if value and value == value then
            value = math.clamp(value, minimum, maximum)
            if integer then value = math.floor(value + 0.5) end
            setter(value)
        end
        refresh()
    end)
    table.insert(Updates, function()
        if not input:IsFocused() then
            input.Text = integer and tostring(getter()) or string.format("%.2f", getter())
        end
    end)
    return input
end


for _, kind in ipairs(KINDS) do
    UI.toggle(mainPage, kind, function() return CFG[kind] end, function(value) CFG[kind] = value end)
end
UI.number(mainPage, "Plot", function() return CFG.Plot end, function(value)
    if S.busy or hasPending() then status("Resolve or release pending offers before changing plots.") return end
    pause("Plot changed. Press Start when ready.")
    CFG.Plot = value
    Records = {}
end, 1, 8, true)

for _, kind in ipairs(KINDS) do
    local page = Pages[kind]
    UI.toggle(page, "Roll " .. kind:lower(), function() return CFG[kind] end, function(value) CFG[kind] = value end)
    local actions = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
        LayoutOrder = UI.next()}, page)
    UI.make("UIGridLayout", {CellSize = UDim2.new(0.5, -2, 1, 0), CellPadding = UDim2.fromOffset(3, 0),
        SortOrder = Enum.SortOrder.LayoutOrder}, actions)
    local selectAll = UI.make("TextButton", {Text = "Select all", Font = Enum.Font.Gotham, TextSize = 8,
        TextColor3 = UI.mint, BackgroundColor3 = UI.row, AutoButtonColor = false, Active = true}, actions)
    UI.corner(selectAll, 3)
    table.insert(Interactive, selectAll)
    connect(selectAll.Activated, function()
        for _, items in pairs(POOLS[kind]) do
            for _, name in ipairs(items) do CFG.Selected[kind][name] = true end
        end
        refresh()
    end)
    local clearAll = UI.make("TextButton", {Text = "Clear", Font = Enum.Font.Gotham, TextSize = 8,
        TextColor3 = UI.muted, BackgroundColor3 = UI.row, AutoButtonColor = false, Active = true}, actions)
    UI.corner(clearAll, 3)
    table.insert(Interactive, clearAll)
    connect(clearAll.Activated, function() CFG.Selected[kind] = {} refresh() end)

    local search = UI.make("TextBox", {Text = "", PlaceholderText = "Search " .. kind:lower(),
        PlaceholderColor3 = UI.dim, ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 9,
        TextColor3 = UI.text, BackgroundColor3 = Color3.fromRGB(17, 24, 37), Size = UDim2.new(1, 0, 0, 16),
        LayoutOrder = UI.next(), Active = true}, page)
    UI.make("UIStroke", {Color = UI.line, Thickness = 1}, search)
    UI.corner(search, 3)
    UI.make("UIPadding", {PaddingLeft = UDim.new(0, 5)}, search)
    table.insert(Interactive, search)
    connect(search:GetPropertyChangedSignal("Text"), refresh)

    for _, rarity in ipairs(ORDER) do
        local items = POOLS[kind][rarity]
        if items then
            local group = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = UI.next()}, page)
            UI.list(group, 1)
            local head = UI.make("Frame", {Size = UDim2.new(1, 0, 0, UI.RAR), BackgroundColor3 = UI.row,
                LayoutOrder = UI.next()}, group)
            UI.corner(head, 3)
            local expanded = false
            local function countOn()
                local count = 0
                for _, name in ipairs(items) do if CFG.Selected[kind][name] then count = count + 1 end end
                return count
            end
            local master, masterLabel = UI.check(head, rarity, function() return countOn() == #items end,
                function(on)
                    for _, name in ipairs(items) do CFG.Selected[kind][name] = on end
                    if on then expanded = true end
                end, RARITY_COLOR[rarity], UI.RAR)
            master.Size = UDim2.new(1, -40, 1, 0)
            masterLabel.TextSize = 10
            masterLabel.Font = Enum.Font.GothamBold
            local count = UI.text(head, "0/0", 8, UI.dim, 12)
            count.Position = UDim2.new(1, -38, 0, 3)
            count.Size = UDim2.fromOffset(20, 12)
            count.TextXAlignment = Enum.TextXAlignment.Right
            count.LayoutOrder = 0
            local caret = UI.make("TextButton", {Text = "v", Font = Enum.Font.GothamBold, TextSize = 9,
                TextColor3 = UI.dim, BackgroundTransparency = 1, Size = UDim2.fromOffset(15, UI.RAR),
                Position = UDim2.new(1, -16, 0, 0), AutoButtonColor = false, Active = true}, head)
            table.insert(Interactive, caret)
            connect(caret.Activated, function() expanded = not expanded refresh() end)
            local grid = UI.make("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, Visible = false, LayoutOrder = UI.next()}, group)
            UI.make("UIGridLayout", {CellSize = UDim2.new(0.5, -2, 0, UI.CELL), CellPadding = UDim2.fromOffset(3, 1),
                SortOrder = Enum.SortOrder.LayoutOrder}, grid)
            UI.make("UIPadding", {PaddingLeft = UDim.new(0, 3)}, grid)
            local cells = {}
            for _, name in ipairs(items) do
                local cell = UI.check(grid, name, function() return CFG.Selected[kind][name] == true end,
                    function(on) CFG.Selected[kind][name] = on end)
                cells[name] = cell
            end
            table.insert(Updates, function()
                local on = countOn()
                count.Text = on .. "/" .. #items
                local query = normalize(search.Text)
                local matches = 0
                for name, cell in pairs(cells) do
                    local match = query == "" or normalize(name):find(query, 1, true) ~= nil
                    cell.Visible = match
                    if match then matches = matches + 1 end
                end
                group.Visible = matches > 0
                grid.Visible = expanded or query ~= ""
                caret.Text = grid.Visible and "^" or "v"
            end)
        end
    end
    fitCanvas(page)
end


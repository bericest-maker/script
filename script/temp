local function buildPool(kind)
header(string.upper(kind))
for _, rar in ipairs(RARITY_ORDER) do
local items = POOLS[kind][rar]
if items then
local children = {}
toggle(rar, false, function(v)
CFG.Rar[kind][rar] = v
for _, c in ipairs(children) do
c.api.Set(v, false)
CFG.Want[kind][rar][c.name] = v
c.api.SetVisible(v)
end
end, 0, RARITY_COLOR[rar])
for _, item in ipairs(items) do
local t = toggle(item, false, function(v)
CFG.Want[kind][rar][item] = v
end, 14, Color3.fromRGB(175, 180, 200))
t.SetVisible(false)
table.insert(children, {api = t, name = item})
end
end
end
end

buildPool("Buildings")
buildPool("Monsters")

-- auto-select all buildings
CFG.Buildings = true

for rarity, items in pairs(POOLS.Buildings) do
    CFG.Rar.Buildings[rarity] = true

    for _, item in ipairs(items) do
        CFG.Want.Buildings[rarity][item] = true
    end
end

-- auto-select mythic, legendary, and secret monsters
for _, rarity in ipairs({"Mythic", "Legendary", "Secret"}) do
    CFG.Rar.Monsters[rarity] = true

    for _, item in ipairs(POOLS.Monsters[rarity] or {}) do
        CFG.Want.Monsters[rarity][item] = true
    end
end

CFG.Monsters = true

local spacer = Instance.new("Frame")
spacer.Size = UDim2.new(1, 0, 0, 6)
spacer.BackgroundTransparency = 1
spacer.LayoutOrder = 9999
spacer.Parent = scroll

local minimized = false
mini.MouseButton1Click:Connect(function()
minimized = not minimized
scroll.Visible = not minimized
TweenService:Create(main, TweenInfo.new(0.18), {Size = minimized and UDim2.fromOffset(300, 26) or UDim2.fromOffset(300, 390)}):Play()
mini.Text = minimized and "+" or "-"
end)

UIS.InputBegan:Connect(function(i, gp)
if gp then return end
if i.KeyCode == Enum.KeyCode.RightControl then main.Visible = not main.Visible end
end)

do
    local dragging = false
    local dragStart, startPos

    local function isButton(obj)
        return obj:IsA("GuiButton")
    end

    main.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1
        and i.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local mousePos = i.Position
        local objects = LP.PlayerGui:GetGuiObjectsAtPosition(
            mousePos.X, mousePos.Y
        )

        for _, obj in ipairs(objects) do
            if obj:IsA("GuiButton") then
                return
            end
        end

        dragging = true
        dragStart = i.Position
        startPos = main.Position
    end)

    UIS.InputChanged:Connect(function(i)
        if dragging and (
            i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch
        ) then
            local d = i.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

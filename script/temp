drawStatus = function()
    if statusLabel and statusLabel.Parent then
        statusLabel.Text = S.message
        statusLabel.TextColor3 = S.blocked and Color3.fromRGB(255, 179, 64) or UI.mint
    end
end

refresh = function()
    if not S.alive then return end
    for name, tab in pairs(TabButtons) do
        local on = name == currentTab
        tab.BackgroundColor3 = on and Color3.fromRGB(43, 55, 78) or UI.row
        tab.TextColor3 = on and UI.amber or UI.dim
    end
    for _, update in ipairs(Updates) do update() end
    drawStatus()
end

local function pointIn(point, object)
    local node = object
    while node and node ~= gui do
        if node:IsA("GuiObject") then
            if not node.Visible then return false end
            if node == object or node.ClipsDescendants then
                local position, size = node.AbsolutePosition, node.AbsoluteSize
                if point.X < position.X or point.Y < position.Y
                    or point.X > position.X + size.X or point.Y > position.Y + size.Y then
                    return false
                end
            end
        end
        node = node.Parent
    end
    return node == gui
end

local function overInteractive(point)
    for _, object in ipairs(Interactive) do
        if object.Visible and object.Parent and pointIn(point, object) then return true end
    end
    return false
end

local drag = nil
connect(UIS.InputBegan, function(input, processed)
    if input.KeyCode == Enum.KeyCode.RightControl and not UIS:GetFocusedTextBox() then
        main.Visible = not main.Visible
        drag = nil
        return
    end
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    local isTouch = input.UserInputType == Enum.UserInputType.Touch
    if not isMouse and not isTouch then return end
    if not main.Visible then return end
    local point = Vector2.new(input.Position.X, input.Position.Y)
    if not pointIn(point, main) then return end
    if overInteractive(point) then return end
    if isTouch and (processed or not pointIn(point, header)) then return end
    drag = {start = point, center = main.AbsolutePosition + main.AbsoluteSize * 0.5,
        moved = false, touch = isTouch and input or nil}
end)

connect(UIS.InputChanged, function(input)
    if not drag then return end
    if drag.touch then
        if input ~= drag.touch then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local point = Vector2.new(input.Position.X, input.Position.Y)
    local delta = point - drag.start
    if not drag.moved then
        if delta.Magnitude < 4 then return end
        drag.moved = true
    end
    local center = clampCenter(drag.center + delta)
    main.Position = UDim2.fromOffset(center.X, center.Y)
end)

local function endDrag(input)
    if not drag then return end
    if (drag.touch and input == drag.touch) or (not drag.touch and input.UserInputType == Enum.UserInputType.MouseButton1) then
        drag = nil
    end
end
connect(UIS.InputEnded, endDrag)
connect(UIS.WindowFocusReleased, function() drag = nil end)

local cameraConnection
local function bindCamera()
    if cameraConnection then pcall(function() cameraConnection:Disconnect() end) end
    local camera = workspace.CurrentCamera
    if camera then
        cameraConnection = connect(camera:GetPropertyChangedSignal("ViewportSize"), function() fit(false) end)
    end
    fit(false)
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
connect(LP.Idled, idlePulse)
connect(LP.CharacterRemoving, function()
    if S.running then pause("character removed | offers kept") end
end)
connect(gui.Destroying, Runtime.Stop)

applySize()
bindCamera()
fit(true)
refresh()

task.spawn(function()
    while S.alive do
        if CFG.AntiIdle and os.clock() - S.lastIdle >= 60 then idlePulse() end
        if S.running then
            local ok, problem = xpcall(tick, function(message) return tostring(message) end)
            S.busy = false
            if not ok and S.alive then
                for _, record in pairs(Records) do
                    if #record.pending > 0 then
                        S.blocked = {record = record, target = record.pending[1]}
                        break
                    end
                end
                pause("worker paused | " .. tostring(problem))
            end
            task.wait(0.03)
        else
            task.wait(0.15)
        end
    end
end)

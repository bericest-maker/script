drawStatus = function()
    if statusLabel.Parent then
        statusLabel.Text = S.message
        statusLabel.TextColor3 = S.blocked and Color3.fromRGB(225, 184, 126) or UI.accent
    end
end
refresh = function()
    if not S.alive then return end
    for name, tab in pairs(TabButtons) do
        tab.BackgroundColor3 = name == currentTab and Color3.fromRGB(49, 62, 42) or UI.row
        tab.TextColor3 = name == currentTab and UI.accent or UI.muted
    end
    for _, update in ipairs(Updates) do update() end
    drawStatus()
end

connect(minimize.Activated, function()
    minimized = not minimized
    tabBar.Visible = not minimized
    content.Visible = not minimized
    footer.Visible = not minimized
    minimize.Text = minimized and "+" or "-"
    if S.sizeTween then S.sizeTween:Cancel() end
    S.sizeTween = TweenService:Create(main, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = UDim2.fromOffset(windowWidth, minimized and 49 or windowHeight)})
    S.sizeTween:Play()
end)

local drag
local function pointIn(point, object)
    local node = object
    while node and node ~= gui do
        if node:IsA("GuiObject") then
            if not node.Visible then return false end
            if node == object or node.ClipsDescendants then
                local pos, size = node.AbsolutePosition, node.AbsoluteSize
                if point.X < pos.X or point.Y < pos.Y or point.X > pos.X + size.X or point.Y > pos.Y + size.Y then return false end
            end
        end
        node = node.Parent
    end
    return node == gui
end

connect(UIS.InputBegan, function(input, processed)
    if input.KeyCode == Enum.KeyCode.RightControl and not UIS:GetFocusedTextBox() then
        main.Visible = not main.Visible
        drag = nil
        for _, page in pairs(Pages) do page.ScrollingEnabled = true end
        return
    end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local point = Vector2.new(input.Position.X, input.Position.Y)
    if not main.Visible or not pointIn(point, main) then return end
    for _, object in ipairs(Interactive) do if pointIn(point, object) then return end end
    for _, page in pairs(Pages) do
        if page.Visible and pointIn(point, page) and point.X > page.AbsolutePosition.X + page.AbsoluteSize.X - 13 then return end
    end
    drag = {point = point, center = main.AbsolutePosition + main.AbsoluteSize * 0.5,
        touch = input.UserInputType == Enum.UserInputType.Touch and input or nil}
    for _, page in pairs(Pages) do page.ScrollingEnabled = false end
end)

connect(UIS.InputChanged, function(input)
    if not drag then return end
    if drag.touch and input ~= drag.touch then return end
    if not drag.touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local position = Vector2.new(input.Position.X, input.Position.Y)
    local center = clampCenter(drag.center + position - drag.point)
    main.Position = UDim2.fromOffset(center.X, center.Y)
end)

connect(UIS.InputEnded, function(input)
    if drag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input == drag.touch) then
        drag = nil
        for _, page in pairs(Pages) do page.ScrollingEnabled = true end
    end
end)

connect(UIS.WindowFocusReleased, function()
    drag = nil
    for _, page in pairs(Pages) do page.ScrollingEnabled = true end
end)

local cameraConnection
local function bindCamera()
    if cameraConnection then cameraConnection:Disconnect() end
    local camera = workspace.CurrentCamera
    if camera then cameraConnection = connect(camera:GetPropertyChangedSignal("ViewportSize"), function() fit(false) end) end
    fit(false)
end
connect(workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
connect(LP.Idled, idlePulse)
connect(LP.CharacterRemoving, function()
    if S.running then pause("Character removed. Offers kept; Start after respawning.") end
end)
connect(gui.Destroying, Runtime.Stop)
bindCamera()
fit(true)
refresh()

task.spawn(function()
    while S.alive do
        if CFG.AntiIdle and os.clock() - S.lastIdle >= 60 then idlePulse() end
        if S.running then
            local ok, problem = xpcall(tick, function(message) return tostring(message) end)
            S.busy = false
            if not ok and S.alive then
                for _, record in pairs(Records) do
                    if #record.pending > 0 then S.blocked = {record = record, target = record.pending[1]} break end
                end
                pause("Worker paused: " .. tostring(problem))
                warn("AutoRoll: " .. tostring(problem))
            end
            task.wait(0.03)
        else
            task.wait(0.15)
        end
    end
end)

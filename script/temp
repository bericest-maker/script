tabbar.BackgroundTransparency = 1
tabbar.Parent = main

local tabs = {}
local pages = {}
local activeTab = "MAIN"

local function makePage(name)
local p = Instance.new("ScrollingFrame")
p.Name = name
p.Size = UDim2.new(1, -10, 1, -58)
p.Position = UDim2.fromOffset(5, 55)
p.BackgroundTransparency = 1
p.BorderSizePixel = 0
p.ScrollBarThickness = 3
p.ScrollBarImageColor3 = Color3.fromRGB(90, 95, 130)
p.CanvasSize = UDim2.new()
p.AutomaticCanvasSize = Enum.AutomaticSize.Y
p.Visible = false
p.Parent = main
local l = Instance.new("UIListLayout")
l.Padding = UDim.new(0, 3)
l.SortOrder = Enum.SortOrder.LayoutOrder
l.Parent = p
pages[name] = p
return p
end

for i, name in ipairs({"MAIN", "MONSTERS", "BUILDINGS", "TRAITS"}) do
makePage(name)
local b = Instance.new("TextButton")
b.Size = UDim2.new(0.25, -3, 1, 0)
b.Position = UDim2.new((i - 1) * 0.25, (i - 1) * 4, 0, 0)
b.BackgroundColor3 = Color3.fromRGB(28, 31, 44)
b.BorderSizePixel = 0
b.Font = Enum.Font.GothamBold
b.TextSize = 10
b.Text = name
b.TextColor3 = Color3.fromRGB(150, 155, 180)
b.AutoButtonColor = false
b.Parent = tabbar
corner(b, 5)
tabs[name] = b
b.MouseButton1Click:Connect(function()
activeTab = name
for n, t in pairs(tabs) do
t.BackgroundColor3 = (n == name) and Color3.fromRGB(95, 130, 255) or Color3.fromRGB(28, 31, 44)
t.TextColor3 = (n == name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 155, 180)
pages[n].Visible = (n == name)
end
end)
end
tabs.MAIN.BackgroundColor3 = Color3.fromRGB(95, 130, 255)
tabs.MAIN.TextColor3 = Color3.fromRGB(255, 255, 255)
pages.MAIN.Visible = true

local order = {}
local function nextOrder(p)
order[p] = (order[p] or 0) + 1
return order[p]
end

local function header(p, text, col)
local f = Instance.new("TextLabel")
f.Size = UDim2.new(1, 0, 0, 18)
f.BackgroundColor3 = Color3.fromRGB(26, 28, 40)
f.BorderSizePixel = 0
f.Font = Enum.Font.GothamBold
f.TextSize = 11
f.TextColor3 = col or Color3.fromRGB(150, 155, 180)
f.Text = "  " .. text
f.TextXAlignment = Enum.TextXAlignment.Left
f.LayoutOrder = nextOrder(p)
f.Parent = p
corner(f, 4)
return f
end

local function toggle(p, text, default, callback, indent, color)
local b = Instance.new("TextButton")
b.Size = UDim2.new(1, 0, 0, 20)
b.BackgroundColor3 = Color3.fromRGB(22, 24, 33)
b.BorderSizePixel = 0
b.AutoButtonColor = false
b.Text = ""
b.LayoutOrder = nextOrder(p)
b.Parent = p
corner(b, 4)

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.new(1, -34 - (indent or 0), 1, 0)
lbl.Position = UDim2.fromOffset(8 + (indent or 0), 0)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.Gotham
lbl.TextSize = 11
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextColor3 = color or Color3.fromRGB(205, 208, 225)
lbl.Text = text
lbl.Parent = b

local box = Instance.new("Frame")
box.Size = UDim2.fromOffset(14, 14)
box.Position = UDim2.new(1, -22, 0.5, -7)
box.BackgroundColor3 = Color3.fromRGB(38, 41, 55)
box.BorderSizePixel = 0
box.Parent = b
corner(box, 3)

local dot = Instance.new("Frame")
dot.Size = UDim2.fromScale(1, 1)
dot.BackgroundColor3 = Color3.fromRGB(95, 130, 255)
dot.BackgroundTransparency = 1
dot.BorderSizePixel = 0
dot.Parent = box
corner(dot, 3)

local state = default and true or false
local api = {}
local function paint()
dot.BackgroundTransparency = state and 0 or 1
lbl.TextTransparency = state and 0 or 0.35
end
function api.Set(v, fire)
state = v and true or false
paint()
if fire ~= false then callback(state) end
end
function api.Get() return state end
function api.SetVisible(v) b.Visible = v end
b.MouseButton1Click:Connect(function() api.Set(not state) end)
b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(30, 33, 45) end)
b.MouseLeave:Connect(function() b.BackgroundColor3 = Color3.fromRGB(22, 24, 33) end)
paint()
return api
end

local function chipGrid(p, names, color, onToggle)
local rows = math.ceil(#names / 2)
local holder = Instance.new("Frame")
holder.Size = UDim2.new(1, 0, 0, rows * 19 + 2)
holder.BackgroundTransparency = 1
holder.LayoutOrder = nextOrder(p)
holder.Parent = p
local out = {}
for i, name in ipairs(names) do
local col = (i - 1) % 2
local row = math.floor((i - 1) / 2)
local b = Instance.new("TextButton")
b.Size = UDim2.new(0.5, -3, 0, 17)
b.Position = UDim2.new(col * 0.5, col * 6, 0, row * 19)
b.BackgroundColor3 = Color3.fromRGB(24, 27, 38)
b.BorderSizePixel = 0
b.AutoButtonColor = false
b.Text = ""
b.Parent = holder
corner(b, 4)
local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.new(1, -22, 1, 0)
lbl.Position = UDim2.fromOffset(5, 0)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.Gotham
lbl.TextSize = 9
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextTruncate = Enum.TextTruncate.AtEnd
lbl.TextColor3 = color or Color3.fromRGB(175, 180, 200)
lbl.Text = name
lbl.Parent = b
local box = Instance.new("Frame")
box.Size = UDim2.fromOffset(11, 11)
box.Position = UDim2.new(1, -15, 0.5, -5.5)
box.BackgroundColor3 = Color3.fromRGB(38, 41, 55)
box.BorderSizePixel = 0
box.Parent = b
corner(box, 3)
local dot = Instance.new("Frame")
dot.Size = UDim2.fromScale(1, 1)
dot.BackgroundColor3 = Color3.fromRGB(95, 130, 255)
dot.BackgroundTransparency = 1
dot.BorderSizePixel = 0
dot.Parent = box
corner(dot, 3)
local state = false
local api = {}
function api.Set(v, fire)
state = v and true or false
dot.BackgroundTransparency = state and 0 or 1
lbl.TextTransparency = state and 0 or 0.3
if fire ~= false and onToggle then onToggle(name, state) end
end
function api.SetVisible(v) b.Visible = v end
b.MouseButton1Click:Connect(function() api.Set(not state) end)
b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(34, 38, 52) end)
b.MouseLeave:Connect(function() b.BackgroundColor3 = Color3.fromRGB(24, 27, 38) end)
out[name] = api
end
return out
end

local function slider(p, text, min, max, default, step, callback)
local holder = Instance.new("Frame")
holder.Size = UDim2.new(1, 0, 0, 30)
holder.BackgroundColor3 = Color3.fromRGB(22, 24, 33)
holder.BorderSizePixel = 0
holder.LayoutOrder = nextOrder(p)
holder.Parent = p
corner(holder, 4)

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.new(1, -16, 0, 14)
lbl.Position = UDim2.fromOffset(8, 1)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.Gotham
lbl.TextSize = 10
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextColor3 = Color3.fromRGB(200, 203, 220)
lbl.Text = text .. ": " .. tostring(default)
lbl.Parent = holder

local track = Instance.new("Frame")
track.Size = UDim2.new(1, -16, 0, 5)
track.Position = UDim2.fromOffset(8, 18)
track.BackgroundColor3 = Color3.fromRGB(38, 41, 55)
track.BorderSizePixel = 0
track.Parent = holder
corner(track, 3)

local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
fill.BackgroundColor3 = Color3.fromRGB(95, 130, 255)
fill.BorderSizePixel = 0
fill.Parent = track
corner(fill, 3)

local dragging = false
local function setFromX(x)
local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
local val = min + (max - min) * rel
val = math.floor(val / step + 0.5) * step
val = math.clamp(val, min, max)
fill.Size = UDim2.fromScale((val - min) / (max - min), 1)
lbl.Text = text .. ": " .. string.format("%.2f", val)
callback(val)
end
track.InputBegan:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
dragging = true setFromX(i.Position.X)
end
end)
UIS.InputEnded:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)
UIS.InputChanged:Connect(function(i)
if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
setFromX(i.Position.X)
end
end)
end

local function plotRow(p)
local holder = Instance.new("Frame")
holder.Size = UDim2.new(1, 0, 0, 24)
holder.BackgroundColor3 = Color3.fromRGB(22, 24, 33)
holder.BorderSizePixel = 0
holder.LayoutOrder = nextOrder(p)
holder.Parent = p
corner(holder, 4)

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.fromOffset(36, 24)
lbl.Position = UDim2.fromOffset(8, 0)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.Gotham
lbl.TextSize = 11
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextColor3 = Color3.fromRGB(200, 203, 220)
lbl.Text = "Plot"
lbl.Parent = holder

local btns = {}
for i = 1, 8 do
local b = Instance.new("TextButton")
b.Size = UDim2.new(0.125, -4, 0, 16)
b.Position = UDim2.new(0.125 * (i - 1) + 0.125, (i - 1) * 3, 0, 4)
b.BackgroundColor3 = Color3.fromRGB(38, 41, 55)
b.BorderSizePixel = 0
b.Font = Enum.Font.GothamBold
b.TextSize = 10
b.TextColor3 = Color3.fromRGB(215, 218, 235)
b.Text = tostring(i)
b.Parent = holder
corner(b, 4)
btns[i] = b
b.MouseButton1Click:Connect(function()
CFG.Plot = i
for j, o in ipairs(btns) do
o.BackgroundColor3 = (j == i) and Color3.fromRGB(95, 130, 255) or Color3.fromRGB(38, 41, 55)
end
end)
end
for j, o in ipairs(btns) do
o.BackgroundColor3 = (j == CFG.Plot) and Color3.fromRGB(95, 130, 255) or Color3.fromRGB(38, 41, 55)
end
end

local function poolSection(kind, p)
toggle(p, kind .. " Rolling", CFG[kind], function(v)
CFG[kind] = v
end, 0, kind == "Monsters" and Color3.fromRGB(120, 230, 160) or Color3.fromRGB(120, 190, 255))
for _, rar in ipairs(RARITY_ORDER) do
local items = POOLS[kind][rar]
if items then
header(p, rar, RARITY_COLOR[rar])
local chips = chipGrid(p, items, RARITY_COLOR[rar], function(name, v)
CFG.Want[kind][rar][name] = v
end)
toggle(p, "all " .. rar, false, function(v)
for _, item in ipairs(items) do
chips[item].Set(v, false)
CFG.Want[kind][rar][item] = v
end
end, 0, RARITY_COLOR[rar])
end
end
end


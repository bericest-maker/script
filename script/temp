local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local VU = game:GetService("VirtualUser")
local LP = Players.LocalPlayer

local POOLS = {
Buildings = {
Common = {"CorridorCorner","SlowTrap","SpikeTrap","StoneWall","Torch","WoodFloor","WoodWall","YellowCorridor"},
Uncommon = {"ArrowTrap","BearTrap","CorridorEnd","CorridorT","Crossroads","CurvedWall","SpikedBarricade","TrapRoom","TreasureRoom","WoodDoor"},
Rare = {"Armory","ArrowTower","DragonNest","FireTrap","IronGate","LifeSpring","MonsterDen","OilTrap","PotionShop"},
Epic = {"FrostObelisk","Graveyard","PoisonTrap","SawTrap","WarShrine"},
Legendary = {"FallingRocks","FlameSpire","LavaChamber","RuneObelisk"},
Mythic = {"BossRoom","DragonAltar"},
Secret = {"CrystalHall"},
},
Monsters = {
Common = {"BoneGhoul","GoblinScout","SewerRat","Skeleton","Slime"},
Uncommon = {"Archer","CinderKobold","DireWolf","DuskBat","Goblin","GraveSentinel","ImpTrickster"},
Rare = {"BannerGoblin","BoneGuard","EmberDrake","FrostRevenant","Healer","Knight","Mage","MagmaElemental","SporeShaman","WidowSpider"},
Epic = {"AmethystGolem","Bard","EliteKnight","FrostDrake","Golem","HexArcher","Necromancer","ObsidianGargoyle","SwampTroll","VampireLord"},
Legendary = {"GraveWarden","InfernalWarlord","Ironhorn","RoyalKnight","RuneSage","SkeletonKing","StormDrake"},
Mythic = {"DreadKnight","FrostwingDrake","GildedMimic","Lich","SpiritTotem","VenomHydra"},
Secret = {"AbyssalDragon","BansheeQueen","BoneColossus","Cerberus","FurnaceBrute","Mimic","VoidReaper"},
Divine = {"SeraphOfRuin","SunDragon"},
},
}

local RARITY_ORDER = {"Common","Uncommon","Rare","Epic","Legendary","Mythic","Secret","Divine"}
local RARITY_COLOR = {
Common = Color3.fromRGB(175,180,192),
Uncommon = Color3.fromRGB(105,215,120),
Rare = Color3.fromRGB(85,160,255),
Epic = Color3.fromRGB(185,110,255),
Legendary = Color3.fromRGB(255,185,55),
Mythic = Color3.fromRGB(255,90,95),
Secret = Color3.fromRGB(0,235,220),
Divine = Color3.fromRGB(255,245,165),
}

local MUTATIONS = {
{name = "Golden", chance = 0.014244076185714286},
{name = "Cursed", chance = 0.00025},
{name = "Frozen", chance = 0.001998167},
{name = "Infernal", chance = 0.0006665},
}

local CFG = {
Plot = 1,
Buildings = false,
Monsters = false,
RollDelay = 1.5,
BuyWait = 0.05,
TPHeight = 2.8,
RequireMut = false,
AnyMonsterMut = false,
Want = {Buildings = {}, Monsters = {}},
Mut = {},
}

local function clean(s)
if not s then return "" end
s = tostring(s):gsub("%b<>", ""):gsub("[^%w]", ""):lower()
return s
end

local LOOKUP = {Buildings = {}, Monsters = {}}
local SORTED = {Buildings = {}, Monsters = {}}
for kind, pool in pairs(POOLS) do
for rar, items in pairs(pool) do
CFG.Want[kind][rar] = {}
for _, it in ipairs(items) do
CFG.Want[kind][rar][it] = false
local k = clean(it)
local entry = {key = k, rarity = rar, name = it}
LOOKUP[kind][k] = entry
table.insert(SORTED[kind], entry)
end
end
table.sort(SORTED[kind], function(a, b) return #a.key > #b.key end)
end
for _, m in ipairs(MUTATIONS) do CFG.Mut[m.name] = false end

local function char() return LP.Character or LP.CharacterAdded:Wait() end
local function hrp()
local c = char()
return c:FindFirstChild("HumanoidRootPart") or c:WaitForChild("HumanoidRootPart", 5)
end

local function getRollers()
local map = workspace:FindFirstChild("Map")
return map and map:FindFirstChild("Rollers") or nil
end

local function getRoller(kind)
local r = getRollers()
if not r then return nil end
return r:FindFirstChild("Plot" .. tostring(CFG.Plot) .. "_" .. kind)
end

local function pivotOf(inst)
if not inst then return nil end
if inst:IsA("BasePart") then return inst.Position end
if inst:IsA("Model") then
local ok, cf = pcall(function() return inst:GetPivot() end)
if ok then return cf.Position end
end
local p = inst.Parent
while p and p ~= workspace do
if p:IsA("BasePart") then return p.Position end
if p:IsA("Model") then
local ok, cf = pcall(function() return p:GetPivot() end)
if ok then return cf.Position end
end
p = p.Parent
end
local bp = inst:FindFirstChildWhichIsA("BasePart", true)
return bp and bp.Position or nil
end

local function detectPlot()
local r = getRollers()
local root = hrp()
if not (r and root) then return end
local bestPlot, bestDist = nil, math.huge
for i = 1, 8 do
local m = r:FindFirstChild("Plot" .. i .. "_Monsters") or r:FindFirstChild("Plot" .. i .. "_Buildings")
local pos = pivotOf(m)
if pos then
local d = (root.Position - pos).Magnitude
if d < bestDist then
bestDist = d
bestPlot = i
end
end
end
if bestPlot then CFG.Plot = bestPlot end
end
pcall(detectPlot)

local function tpTo(pos, instant)
if not pos then return false end
local root = hrp()
if not root then return false end
local dist = (root.Position - pos).Magnitude
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
root.CFrame = CFrame.new(pos + Vector3.new(0, CFG.TPHeight, 0))
if not instant and dist > 9 then
RunService.Heartbeat:Wait()
task.wait(0.09)
end
return true
end

local function txtOf(o)
if not o then return nil end
local ok, v = pcall(function() return o.Text end)
if ok and type(v) == "string" then return v end
local ok2, v2 = pcall(function() return o.Value end)
if ok2 and type(v2) == "string" then return v2 end
return nil
end

local function findDeep(parent, name)
if not parent then return nil end
local d = parent:FindFirstChild(name)
if d then return d end
return parent:FindFirstChild(name, true)
end

local LOG
local function log(t) if LOG then LOG.Text = tostring(t) end end

local function readDisplay(kind, display)
local label = display:FindFirstChild("OfferLabel")
local rawItem = txtOf(label and label:FindFirstChild("ItemName") or findDeep(display, "ItemName")) or ""
local rawRar = txtOf(label and label:FindFirstChild("Rarity") or findDeep(display, "Rarity")) or ""
local mut = nil
if kind == "Monsters" then
local mutLbl = txtOf(label and label:FindFirstChild("Mutation") or findDeep(display, "Mutation"))
local hay = ((mutLbl or "") .. " " .. rawItem .. " " .. rawRar):lower()
for _, m in ipairs(MUTATIONS) do
if hay:find(m.name:lower(), 1, true) then
mut = m.name
break
end
end
end
local cItem = clean(rawItem)
if cItem == "" then return nil, mut, rawItem end
local found = LOOKUP[kind][cItem]
if not found then
for _, entry in ipairs(SORTED[kind]) do
if cItem:find(entry.key, 1, true) then
found = entry
break
end
end
end
return found, mut, rawItem
end

local function anyMutSelected()
for _, m in ipairs(MUTATIONS) do
if CFG.Mut[m.name] then return true end
end
return false
end

local function hasWantedMut(mut)
if not mut then return false end
if not anyMutSelected() then return true end
return CFG.Mut[mut] == true
end

local function wanted(kind, info, mut)
if not info then return false end
if kind == "Buildings" then
local t = CFG.Want.Buildings[info.rarity]
return (t and t[info.name]) == true
end
if CFG.AnyMonsterMut and hasWantedMut(mut) then
return true
end
local t = CFG.Want.Monsters[info.rarity]
if not (t and t[info.name]) then return false end
if CFG.RequireMut then
return hasWantedMut(mut)
end
return true
end

local function firePrompt(prompt)
pcall(function()
if fireproximityprompt then
fireproximityprompt(prompt)
else
prompt:InputHoldBegin()
task.wait((prompt.HoldDuration or 0) + 0.05)
prompt:InputHoldEnd()
end
end)
end

local function buyDisplay(kind, display, tag)
local prompt = display:FindFirstChild("BuyPrompt") or findDeep(display, "BuyPrompt")
if not (prompt and prompt:IsA("ProximityPrompt")) then return false end
local ppos = pivotOf(prompt)
tpTo(ppos, false)
task.wait(CFG.BuyWait)
local before = txtOf(findDeep(display, "ItemName")) or ""
for attempt = 1, 6 do
if not prompt.Parent or not prompt.Enabled then break end
tpTo(ppos, true)
firePrompt(prompt)
task.wait(math.max(CFG.BuyWait, 0.06))
local after = txtOf(findDeep(display, "ItemName")) or ""
if after ~= before or after == "" then
log("+" .. tag)
return true
end
if attempt >= 2 then task.wait(0.06) end
end
log("+" .. tag)
return true
end

local function getDisplays(roller)
local out = {}
for _, c in ipairs(roller:GetChildren()) do
if c.Name:match("^Display") then table.insert(out, c) end
end
table.sort(out, function(a, b) return a.Name < b.Name end)
return out
end

local function checkAndBuyAll(kind)
local roller = getRoller(kind)
if not roller then return false end
local displays = getDisplays(roller)
local pending = {}
for _, d in ipairs(displays) do
local info, mut = readDisplay(kind, d)
if info and wanted(kind, info, mut) then
table.insert(pending, {d = d, tag = (mut and (mut .. " ") or "") .. info.name})
end
end
if #pending == 0 then return false end
local rpos = pivotOf(roller:FindFirstChild("RollButton") or roller)
for _, p in ipairs(pending) do
buyDisplay(kind, p.d, p.tag)
end
if rpos then tpTo(rpos, true) end
return true
end

local function fireRoll(kind)
local roller = getRoller(kind)
if not roller then
log("!Plot" .. CFG.Plot .. "_" .. kind)
return false
end
local btn = roller:FindFirstChild("RollButton") or findDeep(roller, "RollButton")
local cd = btn and (btn:FindFirstChild("RollClick") or btn:FindFirstChildWhichIsA("ClickDetector", true))
if not cd then cd = roller:FindFirstChildWhichIsA("ClickDetector", true) end
if not cd then
log("!Click " .. kind)
return false
end
tpTo(pivotOf(btn or cd), false)
pcall(function()
if fireclickdetector then
fireclickdetector(cd)
task.wait(0.03)
fireclickdetector(cd, 0)
end
end)
return true
end

task.spawn(function()
while true do
task.wait(25)
pcall(function()
VU:CaptureController()
VU:ClickButton2(Vector2.new(0, 0))
end)
end
end)
pcall(function()
LP.Idled:Connect(function()
pcall(function()
VU:CaptureController()
VU:ClickButton2(Vector2.new(0, 0))
end)
end)
end)

local running = false
task.spawn(function()
while true do
task.wait(0.04)
if running then
local kinds = {}
if CFG.Monsters then table.insert(kinds, "Monsters") end
if CFG.Buildings then table.insert(kinds, "Buildings") end
if #kinds == 0 then
task.wait(0.3)
else
local bought = false
for _, k in ipairs(kinds) do
if not running then break end
if checkAndBuyAll(k) then bought = true end
end
if bought then
task.wait(0.08)
else
local t0 = os.clock()
for _, k in ipairs(kinds) do
if not running then break end
fireRoll(k)
end
local firstRoller = getRoller(kinds[1])
local firstBtn = firstRoller and (firstRoller:FindFirstChild("RollButton") or firstRoller)
local rem = CFG.RollDelay - (os.clock() - t0)
if #kinds > 1 and firstBtn and rem > 0.25 then
task.wait(rem - 0.2)
tpTo(pivotOf(firstBtn), true)
task.wait(0.2)
elseif rem > 0 then
task.wait(rem)
end
for _, k in ipairs(kinds) do
if not running then break end
checkAndBuyAll(k)
end
end
end
end
end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "UI_" .. tostring(math.random(100000, 999999))
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = true
pcall(function() gui.Parent = game:GetService("CoreGui") end)
if not gui.Parent then gui.Parent = LP:WaitForChild("PlayerGui") end

local function corner(p, r)
local c = Instance.new("UICorner")
c.CornerRadius = UDim.new(0, r or 5)
c.Parent = p
return c
end
local function stroke(p, col, t)
local s = Instance.new("UIStroke")
s.Color = col or Color3.fromRGB(48, 52, 70)
s.Thickness = t or 1
s.Parent = p
return s
end

local BASE_W = 240
local BASE_H = 190
local minimized = false
local userMoved = false
local sliderBusy = false
local suppressClick = false

local main = Instance.new("Frame")
main.AnchorPoint = Vector2.new(0.5, 0.5)
main.Position = UDim2.fromScale(0.5, 0.5)
main.Size = UDim2.fromOffset(BASE_W, BASE_H)
main.BackgroundColor3 = Color3.fromRGB(15, 16, 23)
main.BorderSizePixel = 0
main.Active = true
main.ClipsDescendants = true
main.Parent = gui
corner(main, 7)
stroke(main, Color3.fromRGB(58, 63, 88), 1)

local uiScale = Instance.new("UIScale")
uiScale.Scale = 1
uiScale.Parent = main

local pages = {}
local pageUpdaters = {}
local activeTab = "Main"

local function refreshAllCanvases()
for _, fn in pairs(pageUpdaters) do fn() end
end

local function fit()
local cam = workspace.CurrentCamera
local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
if vs.X < 20 or vs.Y < 20 then return end
local s = math.clamp(math.min((vs.X * 0.90) / BASE_W, (vs.Y * 0.90) / 148), 0.32, 1.32)
uiScale.Scale = s
BASE_H = math.clamp(math.floor((vs.Y * 0.86) / s), 144, 320)
main.Size = UDim2.fromOffset(BASE_W, minimized and 22 or BASE_H)
if not userMoved then
main.Position = UDim2.fromScale(0.5, 0.5)
else
local hw = (BASE_W * s) * 0.5
local hh = ((minimized and 22 or BASE_H) * s) * 0.5
local cx = main.Position.X.Scale * vs.X + main.Position.X.Offset
local cy = main.Position.Y.Scale * vs.Y + main.Position.Y.Offset
cx = math.clamp(cx, math.min(hw, vs.X * 0.5), math.max(vs.X - hw, vs.X * 0.5))
cy = math.clamp(cy, math.min(hh, vs.Y * 0.5), math.max(vs.Y - hh, vs.Y * 0.5))
main.Position = UDim2.fromOffset(cx, cy)
end
task.defer(refreshAllCanvases)
end

local bar = Instance.new("Frame")
bar.Size = UDim2.new(1, 0, 0, 22)
bar.BackgroundColor3 = Color3.fromRGB(23, 25, 36)
bar.BorderSizePixel = 0
bar.Parent = main
corner(bar, 7)

local tabs = {}
local TAB_LIST = {
{id = "Main", w = 44},
{id = "Monsters", w = 59},
{id = "Buildings", w = 59},
{id = "Traits", w = 46},
}

local function makePage(name)
local p = Instance.new("ScrollingFrame")
p.Name = name
p.Size = UDim2.new(1, -6, 1, -26)
p.Position = UDim2.fromOffset(3, 24)
p.BackgroundTransparency = 1
p.BorderSizePixel = 0
p.Active = true
p.ScrollingEnabled = true
p.ScrollingDirection = Enum.ScrollingDirection.Y
p.ElasticBehavior = Enum.ElasticBehavior.Never
p.ScrollBarThickness = 6
p.ScrollBarImageColor3 = Color3.fromRGB(105, 130, 255)
p.AutomaticCanvasSize = Enum.AutomaticSize.None
p.CanvasSize = UDim2.fromOffset(0, 0)
p.Visible = false
p.Parent = main
local pad = Instance.new("UIPadding")
pad.PaddingRight = UDim.new(0, 8)
pad.PaddingBottom = UDim.new(0, 6)
pad.Parent = p
local l = Instance.new("UIListLayout")
l.Padding = UDim.new(0, 3)
l.SortOrder = Enum.SortOrder.LayoutOrder
l.Parent = p
local function upd()
local h = 10
for _, ch in ipairs(p:GetChildren()) do
if ch:IsA("GuiObject") and ch.Visible then
h = h + ch.Size.Y.Offset + 3
end
end
p.CanvasSize = UDim2.fromOffset(0, h)
end
pages[name] = p
pageUpdaters[name] = upd
return p
end

local xOff = 3
for _, info in ipairs(TAB_LIST) do
local name = info.id
makePage(name)
local b = Instance.new("TextButton")
b.Size = UDim2.fromOffset(info.w, 16)
b.Position = UDim2.fromOffset(xOff, 3)
b.BackgroundColor3 = Color3.fromRGB(32, 35, 50)
b.BorderSizePixel = 0
b.AutoButtonColor = false
b.Font = Enum.Font.GothamBold
b.TextSize = 9
b.Text = name
b.TextColor3 = Color3.fromRGB(165, 170, 195)
b.Parent = bar
corner(b, 4)
tabs[name] = b
xOff = xOff + info.w + 2
b.MouseButton1Click:Connect(function()
if suppressClick then return end
activeTab = name
if minimized then
minimized = false
main.Size = UDim2.fromOffset(BASE_W, BASE_H)
end
for n, t in pairs(tabs) do
local on = (n == name)
t.BackgroundColor3 = on and Color3.fromRGB(88, 118, 255) or Color3.fromRGB(32, 35, 50)
t.TextColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(165, 170, 195)
pages[n].Visible = on
end
pageUpdaters[name]()
end)
end

local mini = Instance.new("TextButton")
mini.Size = UDim2.fromOffset(19, 16)
mini.Position = UDim2.new(1, -22, 0, 3)
mini.BackgroundColor3 = Color3.fromRGB(40, 44, 62)
mini.BorderSizePixel = 0
mini.AutoButtonColor = false
mini.Font = Enum.Font.GothamBold
mini.TextSize = 11
mini.Text = "-"
mini.TextColor3 = Color3.fromRGB(225, 228, 245)
mini.Parent = bar
corner(mini, 4)

mini.MouseButton1Click:Connect(function()
if suppressClick then return end
minimized = not minimized
for n, p in pairs(pages) do p.Visible = (not minimized) and (n == activeTab) end
main.Size = UDim2.fromOffset(BASE_W, minimized and 22 or BASE_H)
mini.Text = minimized and "+" or "-"
if not minimized then pageUpdaters[activeTab]() end
end)

tabs.Main.BackgroundColor3 = Color3.fromRGB(88, 118, 255)
tabs.Main.TextColor3 = Color3.fromRGB(255, 255, 255)
pages.Main.Visible = true

local order = {}
local function nextOrder(p)
order[p] = (order[p] or 0) + 1
return order[p]
end

local ON_COL = Color3.fromRGB(72, 226, 132)
local OFF_COL = Color3.fromRGB(235, 92, 102)
local ON_BG = Color3.fromRGB(25, 52, 38)
local OFF_BG = Color3.fromRGB(44, 27, 34)

local function toggleRow(p, text, default, callback, color)
local b = Instance.new("TextButton")
b.Size = UDim2.new(1, 0, 0, 19)
b.BackgroundColor3 = Color3.fromRGB(22, 25, 36)
b.BorderSizePixel = 0
b.AutoButtonColor = false
b.Text = ""
b.LayoutOrder = nextOrder(p)
b.Parent = p
corner(b, 4)

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.new(1, -30, 1, 0)
lbl.Position = UDim2.fromOffset(6, 0)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.GothamSemibold
lbl.TextSize = 10
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextTruncate = Enum.TextTruncate.AtEnd
lbl.TextColor3 = color or Color3.fromRGB(215, 220, 238)
lbl.Text = text
lbl.Parent = b

local badge = Instance.new("TextLabel")
badge.Size = UDim2.fromOffset(18, 13)
badge.Position = UDim2.new(1, -22, 0.5, -6.5)
badge.Font = Enum.Font.GothamBold
badge.TextSize = 9
badge.Parent = b
corner(badge, 3)

local state = default and true or false
local api = {}
local function paint()
badge.Text = state and "V" or "X"
badge.TextColor3 = state and ON_COL or OFF_COL
badge.BackgroundColor3 = state and ON_BG or OFF_BG
lbl.TextTransparency = state and 0 or 0.25
end
function api.Set(v, fire)
state = v and true or false
paint()
if fire ~= false and callback then callback(state) end
end
function api.Get() return state end
b.MouseButton1Click:Connect(function()
if suppressClick then return end
api.Set(not state)
end)
paint()
return api
end

local function sliderRow(p, text, min, max, default, step, callback)
local holder = Instance.new("Frame")
holder.Size = UDim2.new(1, 0, 0, 26)
holder.BackgroundColor3 = Color3.fromRGB(22, 25, 36)
holder.BorderSizePixel = 0
holder.LayoutOrder = nextOrder(p)
holder.Parent = p
corner(holder, 4)

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.new(1, -12, 0, 12)
lbl.Position = UDim2.fromOffset(6, 1)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.Gotham
lbl.TextSize = 9
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextColor3 = Color3.fromRGB(205, 210, 230)
lbl.Text = text .. ": " .. string.format("%.2f", default)
lbl.Parent = holder

local hit = Instance.new("Frame")
hit.Size = UDim2.new(1, -12, 0, 12)
hit.Position = UDim2.fromOffset(6, 13)
hit.BackgroundTransparency = 1
hit.Active = true
hit.Parent = holder

local track = Instance.new("Frame")
track.Size = UDim2.new(1, 0, 0, 5)
track.Position = UDim2.fromOffset(0, 4)
track.BackgroundColor3 = Color3.fromRGB(38, 42, 58)
track.BorderSizePixel = 0
track.Parent = hit
corner(track, 3)

local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
fill.BackgroundColor3 = Color3.fromRGB(88, 118, 255)
fill.BorderSizePixel = 0
fill.Parent = track
corner(fill, 3)

local dragging = false
local function setFromX(x)
local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
local val = math.clamp(math.floor((min + (max - min) * rel) / step + 0.5) * step, min, max)
fill.Size = UDim2.fromScale((val - min) / (max - min), 1)
lbl.Text = text .. ": " .. string.format("%.2f", val)
callback(val)
end
hit.InputBegan:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
dragging = true
sliderBusy = true
setFromX(i.Position.X)
end
end)
UIS.InputChanged:Connect(function(i)
if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
setFromX(i.Position.X)
end
end)
UIS.InputEnded:Connect(function(i)
if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
dragging = false
task.defer(function() sliderBusy = false end)
end
end)
end

local function plotRow(p)
local holder = Instance.new("Frame")
holder.Size = UDim2.new(1, 0, 0, 21)
holder.BackgroundColor3 = Color3.fromRGB(22, 25, 36)
holder.BorderSizePixel = 0
holder.LayoutOrder = nextOrder(p)
holder.Parent = p
corner(holder, 4)

local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.fromOffset(28, 21)
lbl.Position = UDim2.fromOffset(6, 0)
lbl.BackgroundTransparency = 1
lbl.Font = Enum.Font.GothamSemibold
lbl.TextSize = 9
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextColor3 = Color3.fromRGB(205, 210, 230)
lbl.Text = "Plot"
lbl.Parent = holder

local btns = {}
local function paint()
for j, o in ipairs(btns) do
o.BackgroundColor3 = (j == CFG.Plot) and Color3.fromRGB(88, 118, 255) or Color3.fromRGB(36, 40, 56)
end
end
for i = 1, 8 do
local b = Instance.new("TextButton")
b.Size = UDim2.new(0, 21, 0, 15)
b.Position = UDim2.fromOffset(33 + (i - 1) * 23, 3)
b.BorderSizePixel = 0
b.AutoButtonColor = false
b.Font = Enum.Font.GothamBold
b.TextSize = 9
b.TextColor3 = Color3.fromRGB(230, 232, 245)
b.Text = tostring(i)
b.Parent = holder
corner(b, 3)
btns[i] = b
b.MouseButton1Click:Connect(function()
if suppressClick then return end
CFG.Plot = i
paint()
end)
end
paint()
return paint
end

local function groupBlock(p, titleText, titleColor, names, onItemChange)
local head = Instance.new("Frame")
head.Size = UDim2.new(1, 0, 0, 19)
head.BackgroundColor3 = Color3.fromRGB(26, 29, 43)
head.BorderSizePixel = 0
head.LayoutOrder = nextOrder(p)
head.Parent = p
corner(head, 4)

local foldBtn = Instance.new("TextButton")
foldBtn.Size = UDim2.fromOffset(18, 19)
foldBtn.BackgroundTransparency = 1
foldBtn.AutoButtonColor = false
foldBtn.Font = Enum.Font.GothamBold
foldBtn.TextSize = 9
foldBtn.Text = "v"
foldBtn.TextColor3 = Color3.fromRGB(150, 156, 185)
foldBtn.Parent = head

local headBtn = Instance.new("TextButton")
headBtn.Size = UDim2.new(1, -18, 1, 0)
headBtn.Position = UDim2.fromOffset(18, 0)
headBtn.BackgroundTransparency = 1
headBtn.AutoButtonColor = false
headBtn.Text = ""
headBtn.Parent = head

local hLbl = Instance.new("TextLabel")
hLbl.Size = UDim2.new(1, -28, 1, 0)
hLbl.BackgroundTransparency = 1
hLbl.Font = Enum.Font.GothamBold
hLbl.TextSize = 10
hLbl.TextXAlignment = Enum.TextXAlignment.Left
hLbl.TextColor3 = titleColor
hLbl.Text = titleText
hLbl.Parent = headBtn

local hBadge = Instance.new("TextLabel")
hBadge.Size = UDim2.fromOffset(18, 13)
hBadge.Position = UDim2.new(1, -22, 0.5, -6.5)
hBadge.Font = Enum.Font.GothamBold
hBadge.TextSize = 9
hBadge.Parent = headBtn
corner(hBadge, 3)

local rows = math.ceil(#names / 2)
local grid = Instance.new("Frame")
grid.Size = UDim2.new(1, 0, 0, rows * 18)
grid.BackgroundTransparency = 1
grid.LayoutOrder = nextOrder(p)
grid.Parent = p

local states = {}
local badges = {}
local labels = {}

local function syncHeader()
local allOn = true
local countOn = 0
for _, n in ipairs(names) do
if states[n] then
countOn = countOn + 1
else
allOn = false
end
end
hBadge.Text = allOn and "V" or "X"
hBadge.TextColor3 = allOn and ON_COL or OFF_COL
hBadge.BackgroundColor3 = allOn and ON_BG or OFF_BG
hLbl.Text = titleText .. " (" .. countOn .. "/" .. #names .. ")"
end

local function paintItem(n)
local st = states[n]
badges[n].Text = st and "V" or "X"
badges[n].TextColor3 = st and ON_COL or OFF_COL
badges[n].BackgroundColor3 = st and ON_BG or OFF_BG
labels[n].TextTransparency = st and 0 or 0.3
end

for i, n in ipairs(names) do
states[n] = false
local col = (i - 1) % 2
local row = math.floor((i - 1) / 2)
local b = Instance.new("TextButton")
b.Size = UDim2.new(0.5, -2, 0, 16)
b.Position = UDim2.new(col * 0.5, col * 4, 0, row * 18)
b.BackgroundColor3 = Color3.fromRGB(20, 23, 33)
b.BorderSizePixel = 0
b.AutoButtonColor = false
b.Text = ""
b.Parent = grid
corner(b, 3)

local il = Instance.new("TextLabel")
il.Size = UDim2.new(1, -22, 1, 0)
il.Position = UDim2.fromOffset(4, 0)
il.BackgroundTransparency = 1
il.Font = Enum.Font.Gotham
il.TextScaled = true
il.TextXAlignment = Enum.TextXAlignment.Left
il.TextColor3 = titleColor
il.Text = i .. " " .. n
il.Parent = b
local tc = Instance.new("UITextSizeConstraint")
tc.MinTextSize = 6
tc.MaxTextSize = 8
tc.Parent = il

local ib = Instance.new("TextLabel")
ib.Size = UDim2.fromOffset(14, 12)
ib.Position = UDim2.new(1, -16, 0.5, -6)
ib.Font = Enum.Font.GothamBold
ib.TextSize = 8
ib.Parent = b
corner(ib, 2)

badges[n] = ib
labels[n] = il
paintItem(n)

b.MouseButton1Click:Connect(function()
if suppressClick then return end
states[n] = not states[n]
paintItem(n)
onItemChange(n, states[n])
syncHeader()
end)
end

headBtn.MouseButton1Click:Connect(function()
if suppressClick then return end
local allOn = true
for _, n in ipairs(names) do
if not states[n] then allOn = false break end
end
local target = not allOn
for _, n in ipairs(names) do
states[n] = target
paintItem(n)
onItemChange(n, target)
end
syncHeader()
end)

local open = true
foldBtn.MouseButton1Click:Connect(function()
if suppressClick then return end
open = not open
grid.Visible = open
foldBtn.Text = open and "v" or ">"
if pageUpdaters[p.Name] then pageUpdaters[p.Name]() end
end)

syncHeader()
end

local syncMonstersUI, syncBuildingsUI

local mainMon = toggleRow(pages.Main, "Roll Monsters", false, function(v)
CFG.Monsters = v
if syncMonstersUI then syncMonstersUI.Set(v, false) end
end, Color3.fromRGB(115, 235, 160))

local mainBld = toggleRow(pages.Main, "Roll Buildings", false, function(v)
CFG.Buildings = v
if syncBuildingsUI then syncBuildingsUI.Set(v, false) end
end, Color3.fromRGB(115, 190, 255))

toggleRow(pages.Main, "Run Loop", false, function(v)
running = v
log(v and "on" or "idle")
end, Color3.fromRGB(255, 220, 110))

plotRow(pages.Main)
sliderRow(pages.Main, "Roll Wait", 0.5, 4.0, CFG.RollDelay, 0.1, function(v) CFG.RollDelay = v end)
sliderRow(pages.Main, "Buy Speed", 0.02, 0.35, CFG.BuyWait, 0.01, function(v) CFG.BuyWait = v end)

local statusBox = Instance.new("Frame")
statusBox.Size = UDim2.new(1, 0, 0, 22)
statusBox.BackgroundColor3 = Color3.fromRGB(19, 21, 30)
statusBox.BorderSizePixel = 0
statusBox.LayoutOrder = nextOrder(pages.Main)
statusBox.Parent = pages.Main
corner(statusBox, 4)

LOG = Instance.new("TextLabel")
LOG.Size = UDim2.new(1, -10, 1, 0)
LOG.Position = UDim2.fromOffset(5, 0)
LOG.BackgroundTransparency = 1
LOG.Font = Enum.Font.Code
LOG.TextSize = 8
LOG.TextTruncate = Enum.TextTruncate.AtEnd
LOG.TextXAlignment = Enum.TextXAlignment.Left
LOG.TextColor3 = Color3.fromRGB(125, 205, 255)
LOG.Text = "idle"
LOG.Parent = statusBox

syncMonstersUI = toggleRow(pages.Monsters, "Roll Monsters", false, function(v)
CFG.Monsters = v
mainMon.Set(v, false)
end, Color3.fromRGB(115, 235, 160))

for _, rar in ipairs(RARITY_ORDER) do
local items = POOLS.Monsters[rar]
if items then
groupBlock(pages.Monsters, rar, RARITY_COLOR[rar], items, function(item, v)
CFG.Want.Monsters[rar][item] = v
end)
end
end

syncBuildingsUI = toggleRow(pages.Buildings, "Roll Buildings", false, function(v)
CFG.Buildings = v
mainBld.Set(v, false)
end, Color3.fromRGB(115, 190, 255))

for _, rar in ipairs(RARITY_ORDER) do
local items = POOLS.Buildings[rar]
if items then
groupBlock(pages.Buildings, rar, RARITY_COLOR[rar], items, function(item, v)
CFG.Want.Buildings[rar][item] = v
end)
end
end

toggleRow(pages.Traits, "Require Mutation", false, function(v)
CFG.RequireMut = v
end, Color3.fromRGB(255, 205, 115))

toggleRow(pages.Traits, "Buy Any Monster w/ Trait", false, function(v)
CFG.AnyMonsterMut = v
end, Color3.fromRGB(150, 235, 195))

local mutNames = {}
for _, m in ipairs(MUTATIONS) do table.insert(mutNames, m.name) end
groupBlock(pages.Traits, "Mutations", Color3.fromRGB(245, 215, 130), mutNames, function(name, v)
CFG.Mut[name] = v
end)

for _, m in ipairs(MUTATIONS) do
local r = Instance.new("TextLabel")
r.Size = UDim2.new(1, 0, 0, 14)
r.BackgroundTransparency = 1
r.Font = Enum.Font.Code
r.TextSize = 8
r.TextXAlignment = Enum.TextXAlignment.Left
r.TextColor3 = Color3.fromRGB(150, 156, 182)
r.Text = " " .. m.name .. " = " .. tostring(m.chance)
r.LayoutOrder = nextOrder(pages.Traits)
r.Parent = pages.Traits
end

UIS.InputBegan:Connect(function(i, gp)
if gp then return end
if i.KeyCode == Enum.KeyCode.RightControl then
main.Visible = not main.Visible
end
end)

do
local dragPending, dragging, dragStart, startPos = false, false, nil, nil
local function pointerOf(i)
if i.UserInputType == Enum.UserInputType.Touch then
local gs = game:GetService("GuiService"):GetGuiInset()
return Vector2.new(i.Position.X + gs.X, i.Position.Y + gs.Y)
end
return UIS:GetMouseLocation()
end
local function inRect(pos, guiObj)
local a, s = guiObj.AbsolutePosition, guiObj.AbsoluteSize
return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end
local function inScrollbar(pos)
if minimized then return false end
local pg = pages[activeTab]
if not (pg and pg.Visible) then return false end
local a, s = pg.AbsolutePosition, pg.AbsoluteSize
local zoneW = math.max(12 * uiScale.Scale, 10)
return pos.Y >= a.Y and pos.Y <= a.Y + s.Y and pos.X >= a.X + s.X - zoneW and pos.X <= a.X + s.X + 4
end

UIS.InputBegan:Connect(function(i)
if not main.Visible or sliderBusy then return end
if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
local pos = pointerOf(i)
if not inRect(pos, main) then return end
if inScrollbar(pos) then return end
if i.UserInputType == Enum.UserInputType.Touch and not minimized and pos.Y > bar.AbsolutePosition.Y + bar.AbsoluteSize.Y then
return
end
dragPending = true
dragging = false
dragStart = pos
startPos = main.Position
end)

UIS.InputChanged:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseWheel and main.Visible and not minimized then
local pos = UIS:GetMouseLocation()
local pg = pages[activeTab]
if pg and pg.Visible and inRect(pos, main) then
local beforeY = pg.CanvasPosition.Y
task.defer(function()
if pg.CanvasPosition.Y == beforeY then
local sc = uiScale.Scale > 0 and uiScale.Scale or 1
local maxY = math.max(0, pg.CanvasSize.Y.Offset - pg.AbsoluteWindowSize.Y / sc)
pg.CanvasPosition = Vector2.new(0, math.clamp(beforeY - i.Position.Z * 28, 0, maxY))
end
end)
end
return
end
if sliderBusy then
dragPending = false
dragging = false
return
end
if not dragPending then return end
if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
local d = pointerOf(i) - dragStart
if not dragging and d.Magnitude > 5 then
dragging = true
suppressClick = true
userMoved = true
end
if dragging then
local cam = workspace.CurrentCamera
local vs = cam and cam.ViewportSize or Vector2.new(800, 600)
local cx = startPos.X.Scale * vs.X + startPos.X.Offset + d.X
local cy = startPos.Y.Scale * vs.Y + startPos.Y.Offset + d.Y
main.Position = UDim2.fromOffset(cx, cy)
end
end)

UIS.InputEnded:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
dragPending = false
if dragging then
dragging = false
task.defer(function()
task.wait(0.03)
suppressClick = false
end)
end
end
end)
end

fit()
local function hookCam()
local cam = workspace.CurrentCamera
if cam then
cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end
end
hookCam()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
task.wait()
hookCam()
fit()
end)
refreshAllCanvases()
